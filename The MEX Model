
// The MEX Model - Quarterly Theory Indicator (combined)
// Minimal integration: HTF timeframe options + SMT True Opens / Quarter lines
// Based on QT[✦]Pro++ and QT[✦]Ultimate++ snippets (partial, adapted)
//@version=6
indicator("The MEX Model - Quarterly Theory", shorttitle="MEX Model", overlay=true, max_lines_count=500, max_labels_count=200)

// --- HTF Inputs (allow 90m, 6h, 7h, 12h as options) ---
group_htf = "HTF Candles / Timeframes"
show_htf1 = input.bool(true, "Show HTF 1", group=group_htf)
htf1_tf = input.timeframe('90', 'HTF1 Timeframe', group=group_htf) // default 90m

show_htf2 = input.bool(false, "Show HTF 2", group=group_htf)
htf2_tf = input.timeframe('360', 'HTF2 Timeframe', group=group_htf) // 6h

show_htf3 = input.bool(false, "Show HTF 3", group=group_htf)
htf3_tf = input.timeframe('420', 'HTF3 Timeframe', group=group_htf) // 7h

show_htf4 = input.bool(false, "Show HTF 4", group=group_htf)
htf4_tf = input.timeframe('720', 'HTF4 Timeframe', group=group_htf) // 12h

// allow two more standard HTFs if user wants
show_htf5 = input.bool(false, "Show HTF 5", group=group_htf)
htf5_tf = input.timeframe('D', 'HTF5 Timeframe', group=group_htf)

show_htf6 = input.bool(false, "Show HTF 6", group=group_htf)
htf6_tf = input.timeframe('W', 'HTF6 Timeframe', group=group_htf)

// Colors for HTF open/close
clr_htf_open = input.color(color.new(color.blue, 0), 'HTF Open Color')
clr_htf_close = input.color(color.new(color.orange, 0), 'HTF Close Color')

// helper to request OHLC for a timeframe
htf_ohlc(tf) =>
	htf_o = request.security(syminfo.tickerid, tf, open, gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
	htf_h = request.security(syminfo.tickerid, tf, high, gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
	htf_l = request.security(syminfo.tickerid, tf, low, gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
	htf_c = request.security(syminfo.tickerid, tf, close, gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
	[htf_o, htf_h, htf_l, htf_c]

// draw simple HTF lines (open & close) to represent HTF candles minimally
var line[] htf_lines = array.new_line()
max_htf_lines = 200
create_htf_lines(tf, enabled, colOpen, colClose, prefix) =>
	if not enabled
		[na, na]
	else
		[o, h, l, c] = htf_ohlc(tf)
		htf_time = request.security(syminfo.tickerid, tf, time, gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
		is_new = ta.change(htf_time) != 0
		if is_new
			lo = line.new(x1=htf_time, y1=o, x2=htf_time, y2=o, xloc=xloc.bar_time, extend=extend.right, color=colOpen, width=1, style=line.style_dotted)
			lc = line.new(x1=htf_time, y1=c, x2=htf_time, y2=c, xloc=xloc.bar_time, extend=extend.right, color=colClose, width=1, style=line.style_solid)
			array.unshift(htf_lines, lo)
			array.unshift(htf_lines, lc)
			// trim
			while array.size(htf_lines) > max_htf_lines
				line.delete(array.pop(htf_lines))
		[o, c]
create_htf_lines(htf1_tf, show_htf1, clr_htf_open, clr_htf_close, "HTF1")
create_htf_lines(htf2_tf, show_htf2, clr_htf_open, clr_htf_close, "HTF2")
create_htf_lines(htf3_tf, show_htf3, clr_htf_open, clr_htf_close, "HTF3")
create_htf_lines(htf4_tf, show_htf4, clr_htf_open, clr_htf_close, "HTF4")
create_htf_lines(htf5_tf, show_htf5, clr_htf_open, clr_htf_close, "HTF5")
create_htf_lines(htf6_tf, show_htf6, clr_htf_open, clr_htf_close, "HTF6")

// --- HTF Mini-Candles (bodies + wicks) ---
// draws a small candle representation when an HTF bar starts
var box[] htf_boxes = array.new_box()
var line[] htf_wicks = array.new_line()
max_htf_boxes = 300
minicandle_width = 3 // bars forward for the rectangle
body_opacity_bull = 20
body_opacity_bear = 60

draw_htf_minicandle(tf, enabled) =>
	if not enabled
		na
	else
		htf_time = request.security(syminfo.tickerid, tf, time, gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
		if ta.change(htf_time) != 0
			o = request.security(syminfo.tickerid, tf, open, gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
			h = request.security(syminfo.tickerid, tf, high, gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
			l = request.security(syminfo.tickerid, tf, low, gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
			c = request.security(syminfo.tickerid, tf, close, gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
			is_bull = c >= o
			bgcolor = is_bull ? color.new(color.green, body_opacity_bull) : color.new(color.red, body_opacity_bear)
			border = is_bull ? color.new(color.green, 0) : color.new(color.red, 0)
			// create body box
			bx = box.new(left=bar_index, top=math.max(o, c), right=bar_index + minicandle_width, bottom=math.min(o, c), border_color=border, bgcolor=bgcolor)
			// create wick line centered on box
			x_center = bar_index + int(math.round(minicandle_width / 2))
			wk = line.new(x_center, h, x_center, l, color=border, width=1)
			array.unshift(htf_boxes, bx)
			array.unshift(htf_wicks, wk)
			// trim
			while array.size(htf_boxes) > max_htf_boxes
				box.delete(array.pop(htf_boxes))
			while array.size(htf_wicks) > max_htf_boxes
				line.delete(array.pop(htf_wicks))

// draw mini-candles for enabled HTFs
draw_htf_minicandle(htf1_tf, show_htf1)
draw_htf_minicandle(htf2_tf, show_htf2)
draw_htf_minicandle(htf3_tf, show_htf3)
draw_htf_minicandle(htf4_tf, show_htf4)
draw_htf_minicandle(htf5_tf, show_htf5)
draw_htf_minicandle(htf6_tf, show_htf6)

// --- SMT True Opens & Quarterly math (adapted) ---
group_smt = "SMT / Quarters"
show_smt_quarter = input.bool(true, "Show Quarterly True Open", group=group_smt)
show_smt_90m = input.bool(true, "Show 90m True Open", group=group_smt)
smt_q_color = input.color(color.lime, 'Quarter Open Color', group=group_smt)
smt_90_color = input.color(color.purple, '90m Open Color', group=group_smt)

// timezone and day start for quarter math (defaults similar to QT Ultimate++)
tz = input.string('UTC-4', title='Timezone', options=['UTC-11','UTC-10','UTC-9','UTC-8','UTC-7','UTC-6','UTC-5','UTC-4','UTC-3','UTC-2','UTC-1','UTC','UTC+1','UTC+2','UTC+3','UTC+4','UTC+5','UTC+5:30','UTC+6','UTC+7','UTC+8','UTC+9','UTC+10','UTC+11','UTC+12'])
dayStartHour = input.int(18, "Day Start Hour (TZ)", minval=0, maxval=23, group=group_smt)

msDay   = 24 * 60 * 60 * 1000
ms90m   = 90 * 60 * 1000
yy  = year(time, tz)
mo  = month(time, tz)
dom = dayofmonth(time, tz)

dayStartToday = timestamp(tz, yy, mo, dom, dayStartHour, 0)
dayStart      = time >= dayStartToday ? dayStartToday : (dayStartToday - msDay)
minsFromDayStart = int(((time - dayStart) % msDay) / (60 * 1000))

yy_c  = year(dayStart, tz)
mo_c  = month(dayStart, tz)
dom_c = dayofmonth(dayStart, tz)

// quarterly utils
q2Month = ((mo_c - 1) % 3) + 1
// quarter start timestamp helper
quarter_start_ts() =>
	// compute quarter-first-month
	qmonth = mo_c - ((mo_c - 1) % 3)
	timestamp(tz, yy_c, qmonth, 1, 0, 0)

// track quarter open price
var line[] q_lines = array.new_line()
var float last_q_open = na
if show_smt_quarter
	q_start = quarter_start_ts()
	new_q = ta.change(q2Month) != 0
	// request open and time at quarter start using daily timeframe
	if new_q
		q_open = request.security(syminfo.tickerid, 'D', open, gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
		q_time = request.security(syminfo.tickerid, 'D', time, gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
		ln = line.new(x1=q_time, y1=q_open, x2=q_time, y2=q_open, xloc=xloc.bar_time, extend=extend.right, color=smt_q_color, width=2)
		array.unshift(q_lines, ln)
		while array.size(q_lines) > 40
			line.delete(array.pop(q_lines))
		last_q_open := q_open

// --- SSMT (Normal / Hidden) settings ---
g_ssmt = "SSMT (True Opens)"
show_smtM = input.bool(true, "Show Monthly True Open", group=g_ssmt)
show_smtW = input.bool(true, "Show Weekly True Open", group=g_ssmt)
show_smtD = input.bool(true, "Show Daily True Open", group=g_ssmt)
show_smtN = input.bool(true, "Show 90m True Open", group=g_ssmt)
show_smtm = input.bool(false, "Show Micro True Open", group=g_ssmt)
show_smtY = input.bool(false, "Show Yearly True Open", group=g_ssmt)

// hidden toggles
show_hsmtM = input.bool(false, "Show Hidden Monthly", group=g_ssmt)
show_hsmtW = input.bool(false, "Show Hidden Weekly", group=g_ssmt)
show_hsmtD = input.bool(false, "Show Hidden Daily", group=g_ssmt)
show_hsmtN = input.bool(false, "Show Hidden 90m", group=g_ssmt)
show_hsmtm = input.bool(false, "Show Hidden Micro", group=g_ssmt)
show_hsmtY = input.bool(false, "Show Hidden Yearly", group=g_ssmt)

// colors
clr_smtM = input.color(color.rgb(241,151,15), "Monthly Color", group=g_ssmt)
clr_smtW = input.color(color.rgb(4,138,234), "Weekly Color", group=g_ssmt)
clr_smtD = input.color(color.rgb(200,200,200), "Daily Color", group=g_ssmt)
clr_smtN = input.color(color.purple, "90m Color", group=g_ssmt)
clr_smtm = input.color(color.navy, "Micro Color", group=g_ssmt)
clr_smtY = input.color(color.rgb(228,13,27), "Yearly Color", group=g_ssmt)

clr_hsmt = input.color(color.new(color.gray, 60), "Hidden Color", group=g_ssmt)

// compute smaller period counters for 90m/micro
msMicro = 1350000
minsIn6H = minsFromDayStart % 360
q90 = int(math.floor(minsIn6H / 90)) + 1
msInto90 = int((time - dayStart) % ms90m)
qMicro = int(math.floor(msInto90 / msMicro)) + 1

new_month = ta.change(month(time, tz)) != 0
new_week = ta.change(weekofyear(time, tz)) != 0
new_daily = ta.change(dayofmonth(time, tz)) != 0
new_90m = ta.change(q90) != 0
new_micro = ta.change(qMicro) != 0

// arrays to manage SSMT lines
var line[] ssmt_lines = array.new_line()
max_ssmt = 200

// helper to draw period open line
draw_period_open(line_time, tf_label, open_price, color_in, is_hidden=false) =>
	style = is_hidden ? line.style_dashed : line.style_solid
	w = is_hidden ? 1 : 2
	ln = line.new(x1=line_time, y1=open_price, x2=line_time, y2=open_price, xloc=xloc.bar_time, extend=extend.right, color=color_in, width=w, style=style)
	array.unshift(ssmt_lines, ln)
	while array.size(ssmt_lines) > max_ssmt
		line.delete(array.pop(ssmt_lines))

// Monthly
if show_smtM and new_month
	m_open = request.security(syminfo.tickerid, 'M', open, gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
	m_time = request.security(syminfo.tickerid, 'M', time, gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
	draw_period_open(m_time, 'Monthly', m_open, clr_smtM, false)
if show_hsmtM and new_month
	m_open = request.security(syminfo.tickerid, 'M', open, gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
	m_time = request.security(syminfo.tickerid, 'M', time, gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
	draw_period_open(m_time, 'Hidden Monthly', m_open, clr_hsmt, true)

// Weekly
if show_smtW and new_week
	w_open = request.security(syminfo.tickerid, 'W', open, gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
	w_time = request.security(syminfo.tickerid, 'W', time, gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
	draw_period_open(w_time, 'Weekly', w_open, clr_smtW, false)
if show_hsmtW and new_week
	w_open = request.security(syminfo.tickerid, 'W', open, gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
	w_time = request.security(syminfo.tickerid, 'W', time, gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
	draw_period_open(w_time, 'Hidden Weekly', w_open, clr_hsmt, true)

// Daily
if show_smtD and new_daily
	d_open = request.security(syminfo.tickerid, 'D', open, gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
	d_time = request.security(syminfo.tickerid, 'D', time, gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
	draw_period_open(d_time, 'Daily', d_open, clr_smtD, false)
if show_hsmtD and new_daily
	d_open = request.security(syminfo.tickerid, 'D', open, gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
	d_time = request.security(syminfo.tickerid, 'D', time, gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
	draw_period_open(d_time, 'Hidden Daily', d_open, clr_hsmt, true)

// 90m
if show_smtN and new_90m
	n_open = request.security(syminfo.tickerid, '90', open, gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
	n_time = request.security(syminfo.tickerid, '90', time, gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
	draw_period_open(n_time, '90m', n_open, clr_smtN, false)
if show_hsmtN and new_90m
	n_open = request.security(syminfo.tickerid, '90', open, gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
	n_time = request.security(syminfo.tickerid, '90', time, gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
	draw_period_open(n_time, 'Hidden 90m', n_open, clr_hsmt, true)

// Micro (approximate)
if show_smtm and new_micro
	// approximate micro open using 1m security at the current bar
	mu_open = request.security(syminfo.tickerid, '1', open, gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
	mu_time = request.security(syminfo.tickerid, '1', time, gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
	draw_period_open(mu_time, 'Micro', mu_open, clr_smtm, false)
if show_hsmtm and new_micro
	mu_open = request.security(syminfo.tickerid, '1', open, gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
	mu_time = request.security(syminfo.tickerid, '1', time, gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
	draw_period_open(mu_time, 'Hidden Micro', mu_open, clr_hsmt, true)

// Yearly (approximate using monthly change)
if show_smtY and ta.change(year(time, tz)) != 0
	y_open = request.security(syminfo.tickerid, 'M', open, gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
	y_time = request.security(syminfo.tickerid, 'M', time, gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
	draw_period_open(y_time, 'Yearly', y_open, clr_smtY, false)
if show_hsmtY and ta.change(year(time, tz)) != 0
	y_open = request.security(syminfo.tickerid, 'M', open, gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
	y_time = request.security(syminfo.tickerid, 'M', time, gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
	draw_period_open(y_time, 'Hidden Yearly', y_open, clr_hsmt, true)

// 90m True open lines
var line[] n90_lines = array.new_line()
if show_smt_90m
	// use the 90m timeframe open; draw when new 90m bar starts
	n90_time = request.security(syminfo.tickerid, '90', time, gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
	if ta.change(n90_time) != 0
		n90_open = request.security(syminfo.tickerid, '90', open, gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
		ln2 = line.new(x1=n90_time, y1=n90_open, x2=n90_time, y2=n90_open, xloc=xloc.bar_time, extend=extend.right, color=smt_90_color, width=1, style=line.style_dashed)
		array.unshift(n90_lines, ln2)
		while array.size(n90_lines) > 60
			line.delete(array.pop(n90_lines))

show_avg_pips_dashboard = input.bool(true, 'Show Avg Pips Dashboard', group=group_smt)

to_pips(value) =>
	mult = syminfo.type == 'forex' ? 10.0 : 1.0
	value / (syminfo.mintick * mult)

var float[] avg_6h_ranges = array.new_float()
var float[] avg_90m_q_ranges = array.new_float()
max_avg_items = 40

h6_time = request.security(syminfo.tickerid, '360', time, gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
h6_range_prev = request.security(syminfo.tickerid, '360', high[1] - low[1], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
if ta.change(h6_time) != 0 and not na(h6_range_prev)
	array.unshift(avg_6h_ranges, h6_range_prev)
	while array.size(avg_6h_ranges) > max_avg_items
		array.pop(avg_6h_ranges)

q90_time = request.security(syminfo.tickerid, '90', time, gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
q90_range_prev = request.security(syminfo.tickerid, '90', high[1] - low[1], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
if ta.change(q90_time) != 0 and not na(q90_range_prev) and q90_time >= quarter_start_ts()
	array.unshift(avg_90m_q_ranges, q90_range_prev)
	while array.size(avg_90m_q_ranges) > max_avg_items
		array.pop(avg_90m_q_ranges)

avg_6h_pips = array.size(avg_6h_ranges) > 0 ? to_pips(array.avg(avg_6h_ranges)) : na
avg_90m_q_pips = array.size(avg_90m_q_ranges) > 0 ? to_pips(array.avg(avg_90m_q_ranges)) : na

tf_minutes = timeframe.in_seconds(timeframe.period) / 60
show_6h_dashboard = tf_minutes > 15
show_90m_dashboard = tf_minutes <= 15

var table avg_pips_table = table.new(position.top_right, 1, 3, frame_color=color.new(color.white, 0), border_width=1)
if show_avg_pips_dashboard
	avg_title = show_6h_dashboard ? 'Avg 6H Range' : 'Avg 90m Qtr Range'
	avg_value = show_6h_dashboard ? avg_6h_pips : avg_90m_q_pips
	avg_count = show_6h_dashboard ? array.size(avg_6h_ranges) : array.size(avg_90m_q_ranges)
	avg_text = not na(avg_value) ? str.tostring(avg_value, '#.##') + ' pips' : 'waiting...'
	count_text = 'Count: ' + str.tostring(avg_count)
	table.cell(avg_pips_table, 0, 0, avg_title, text_color=color.white, bgcolor=color.new(color.blue, 80), text_size=size.small)
	table.cell(avg_pips_table, 0, 1, avg_text, text_color=color.white, bgcolor=color.new(color.black, 80), text_size=size.small)
	table.cell(avg_pips_table, 0, 2, count_text, text_color=color.silver, bgcolor=color.new(color.black, 80), text_size=size.tiny)

// Simple labels showing last quarter open / 90m open for convenience
if show_smt_quarter and not na(last_q_open)
	label.new(bar_index, last_q_open, text='Q Open: ' + str.tostring(last_q_open, format.mintick), color=color.new(smt_q_color, 0), style=label.style_label_left, textcolor=color.white)

// final note label
if barstate.islast
	label.new(bar_index, high, text='MEX Model active — HTF & SMT opens', style=label.style_label_right, color=color.new(color.gray, 80), textcolor=color.white)
