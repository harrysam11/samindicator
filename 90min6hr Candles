deleteAll() =>
    int i = 0
    while i < g_bodies.size()
        box.delete(g_bodies.get(i)), i += 1
    g_bodies.clear(), i := 0
    while i < g_wicks_up.size()
        line.delete(g_wicks_up.get(i)), i += 1
    g_wicks_up.clear(), i := 0
    while i < g_wicks_dn.size()
        line.delete(g_wicks_dn.get(i)), i += 1
    g_wicks_dn.clear(), i := 0
    while i < g_fvgs.size()
        box.delete(g_fvgs.get(i)), i += 1
    g_fvgs.clear(), i := 0
    while i < g_sweeps.size()
        line.delete(g_sweeps.get(i)), i += 1
    g_sweeps.clear(), i := 0
    while i < g_mids.size()
        line.delete(g_mids.get(i)), i += 1
    g_mids.clear(), i := 0
    while i < g_timelabels.size()
        label.delete(g_timelabels.get(i)), i += 1
    g_timelabels.clear()
    while g_traces.size() > 0
        line.delete(g_traces.pop())

