f_get_custom_htf(int target_mins, array<int> arr_t, array<float> arr_o, array<float> arr_h, array<float> arr_l, array<float> arr_c) =>
    array<float> out_o = array.new<float>()
    array<float> out_h = array.new<float>()
    array<float> out_l = array.new<float>()
    array<float> out_c = array.new<float>()
    array<int>   out_t = array.new<int>()
    
    int sz = array.size(arr_t)
    if sz > 0
        int last_htf_open = -1
        float cur_o = na, float cur_h = na, float cur_l = na, float cur_c = na
        int cur_t = na
        
        for i = sz - 1 to 0
            int t = array.get(arr_t, i)
            int h_ny = hour(t, "America/New_York")
            int m_ny = minute(t, "America/New_York")
            
            int elapsed_mins_today = h_ny * 60 + m_ny
            int anchor_mins_today = eff_hr * 60 + eff_min
            
            int shift_mins = elapsed_mins_today - anchor_mins_today
            if shift_mins < 0
                shift_mins += 1440
                
            int htf_open_time = t - ((shift_mins % target_mins) * 60000)
            
            if htf_open_time != last_htf_open
                if last_htf_open != -1
                    array.push(out_o, cur_o), array.push(out_h, cur_h), array.push(out_l, cur_l), array.push(out_c, cur_c), array.push(out_t, cur_t)
                    if array.size(out_o) >= 5
                        break
                        
                last_htf_open := htf_open_time
                cur_c := array.get(arr_c, i), cur_h := array.get(arr_h, i), cur_l := array.get(arr_l, i), cur_o := array.get(arr_o, i), cur_t := htf_open_time
            else
                cur_h := math.max(cur_h, array.get(arr_h, i)), cur_l := math.min(cur_l, array.get(arr_l, i)), cur_o := array.get(arr_o, i)
                
        if array.size(out_o) < 5 and last_htf_open != -1
            array.push(out_o, cur_o), array.push(out_h, cur_h), array.push(out_l, cur_l), array.push(out_c, cur_c), array.push(out_t, cur_t)
            
    while array.size(out_o) < 5
        array.push(out_o, na), array.push(out_h, na), array.push(out_l, na), array.push(out_c, na), array.push(out_t, na)
        
    [out_o, out_h, out_l, out_c, out_t]

f_get_custom_htf_oc(int target_mins, array<int> arr_t, array<float> arr_o, array<float> arr_c) =>
    array<float> out_o = array.new<float>()
    array<float> out_c = array.new<float>()
    
    int sz = array.size(arr_t)
    if sz > 0
        int last_htf_open = -1
        float cur_o = na, float cur_c = na
        for i = sz - 1 to 0
            int t = array.get(arr_t, i)
            int h_ny = hour(t, "America/New_York"), m_ny = minute(t, "America/New_York")
            int shift_mins = (h_ny * 60 + m_ny) - (eff_hr * 60 + eff_min)
            if shift_mins < 0
                shift_mins += 1440
            int htf_open_time = t - ((shift_mins % target_mins) * 60000)

            if htf_open_time != last_htf_open
                if last_htf_open != -1
                    array.push(out_o, cur_o), array.push(out_c, cur_c)
                    if array.size(out_o) >= 5
                        break
                last_htf_open := htf_open_time
                cur_c := array.get(arr_c, i), cur_o := array.get(arr_o, i)
            else
                cur_o := array.get(arr_o, i)
                
        if array.size(out_o) < 5 and last_htf_open != -1
            array.push(out_o, cur_o), array.push(out_c, cur_c)
            
    while array.size(out_o) < 5
