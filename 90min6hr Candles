drawCandle(float o, float h, float l, float c, int t, int slot, int startOff, TFColors col, int psp_status) =>
    int x1 = bar_index + startOff + slot * (i_width + i_buffer)
    int x2 = x1 + i_width
    int xm = x1 + i_width / 2
    bool bull = c >= o
    
    color b_col = bull ? col.bull_body : col.bear_body
    if psp_status == 1
        b_col := i_psp_bear_col
    else if psp_status == 2
        b_col := i_psp_bull_col
        
    box bd = box.new(x1, math.max(o,c), x2, math.min(o,c),
             bull ? col.bull_border : col.bear_border, 1,
             bgcolor = b_col)
    line wu = line.new(xm, h, xm, math.max(o,c), color = bull ? col.bull_wick : col.bear_wick)
    line wd = line.new(xm, math.min(o,c), xm, l,  color = bull ? col.bull_wick : col.bear_wick)
    g_bodies.push(bd)
    g_wicks_up.push(wu)
    g_wicks_dn.push(wd)
    
    if i_show_time and not na(t)
        label tl = label.new(xm, l, formatTime(t),
                     color=transparent, textcolor=i_time_color,
                     style=label.style_label_up, size=size.normal,
                     text_font_family=font.family_monospace)
        g_timelabels.push(tl)
    [x1, x2, h, l]

// ══════════════════════════════════════════════════════════════
//  DRAW BLOCK
// ══════════════════════════════════════════════════════════════
drawBlock(
     float o0, float h0, float l0, float c0, int t0,
     float o1, float h1, float l1, float c1, int t1,
     float o2, float h2, float l2, float c2, int t2,
     float o3, float h3, float l3, float c3, int t3,
     float o4, float h4, float l4, float c4, int t4,
     array<int> psp_arr, int startOff, int n, TFColors col) =>

    os = array.from(o4, o3, o2, o1, o0)
    hs = array.from(h4, h3, h2, h1, h0)
    ls = array.from(l4, l3, l2, l1, l0)
    cs = array.from(c4, c3, c2, c1, c0)
    ts = array.from(t4, t3, t2, t1, t0)

    int si = 5 - n

    xs1  = array.new<int>()
    xs2  = array.new<int>()
    chs  = array.new<float>()
    cls  = array.new<float>()
    cos  = array.new<float>()
    ccs  = array.new<float>()
    float blockHigh = 0.0

    int slot = 0
    while slot < n
        int idx = si + slot
        float co = os.get(idx)
        float ch = hs.get(idx)
        float cl = ls.get(idx)
        float cc = cs.get(idx)
        int   ct = ts.get(idx)
        
        int p_idx = 4 - idx // Match array indexing for PSP
        int psp_status = psp_arr.get(p_idx)
        
        if not na(co)
            [x1, x2, cvh, cvl] = drawCandle(co, ch, cl, cc, ct, slot, startOff, col, psp_status)
            xs1.push(x1)
            xs2.push(x2)
            chs.push(ch)
            cls.push(cl)
            cos.push(co)
            ccs.push(cc)
            if ch > blockHigh
                blockHigh := ch
        slot += 1

    int drawn = xs1.size()

    if i_mid_show and drawn >= 2
        int i = 0
        while i < drawn - 1
            float mid = calcMidpoint(chs.get(i), cls.get(i), cos.get(i), ccs.get(i))
            int mx1 = xs1.get(i)   + i_width / 2
            int mx2 = xs1.get(i+1) + i_width / 2
            g_mids.push(line.new(mx1, mid, mx2, mid, color=i_mid_color, style=line.style_dotted, width=1))
            i += 1

    if i_sweep_show and drawn >= 2
        int i = 0
        while i < drawn - 1
            float ph = chs.get(i)
            float pl = cls.get(i)
            float nh = chs.get(i+1)
            float nl = cls.get(i+1)
            float nc = ccs.get(i+1)
            int sx1 = xs1.get(i)   + i_width / 2
            int sx2 = xs2.get(i+1)
            if nh > ph and nc < ph
                g_sweeps.push(line.new(sx1, ph, sx2, ph, color=i_sweep_color, width=1))
            if nl < pl and nc > pl
                g_sweeps.push(line.new(sx1, pl, sx2, pl, color=i_sweep_color, width=1))
            i += 1

    if i_fvg_show and drawn >= 3
        int i = 0
        while i < drawn - 2
            float h1f = chs.get(i)
            float l1f = cls.get(i)
            float h3f = chs.get(i+2)
            float l3f = cls.get(i+2)
            int fx1 = xs1.get(i)
            int fx2 = xs2.get(i+2)
            if l1f > h3f
                g_fvgs.push(box.new(fx1, l1f, fx2, h3f, bgcolor=i_fvg_color, border_color=transparent))
            if h1f < l3f
                g_fvgs.push(box.new(fx1, l3f, fx2, h1f, bgcolor=i_fvg_color, border_color=transparent))
            i += 1

    int totalW  = n * i_width + math.max(0, n-1) * i_buffer
    int centerX = bar_index + startOff + totalW / 2
    [centerX, blockHigh, startOff + totalW + i_htfgap]

