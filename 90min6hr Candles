// ══════════════════════════════════════════════════════════════
//  PSP CALCULATION ENGINE
// ══════════════════════════════════════════════════════════════
f_calc_psp(array<float> os, array<float> hs, array<float> ls, array<float> cs, array<float> o2, array<float> c2, array<float> o3, array<float> c3, array<float> o4, array<float> c4) =>
    array<int> psp = array.new<int>(5, 0)
    int left = i_psp_left
    int right = i_psp_right

    for i = right to (4 - left)
        if na(os.get(i))
            continue

        bool is_ph = true
        for j = 1 to left
            if hs.get(i) <= hs.get(i + j)
                is_ph := false
        for j = 1 to right
            if hs.get(i) <= hs.get(i - j)
                is_ph := false

        bool is_pl = true
        for j = 1 to left
            if ls.get(i) >= ls.get(i + j)
                is_pl := false
        for j = 1 to right
            if ls.get(i) >= ls.get(i - j)
                is_pl := false

        if is_ph or is_pl
            bool b1 = cs.get(i) >= os.get(i)
            bool crack = false

            if ticker2 != "" and array.size(o2) > i and not na(o2.get(i))
                bool b2 = (c2.get(i) >= o2.get(i))
                if inv2
                    b2 := not b2
                if b1 != b2
                    crack := true

            if ticker3 != "" and array.size(o3) > i and not na(o3.get(i))
                bool b3 = (c3.get(i) >= o3.get(i))
                if inv3
                    b3 := not b3
                if b1 != b3
                    crack := true

            if ticker4 != "" and array.size(o4) > i and not na(o4.get(i))
                bool b4 = (c4.get(i) >= o4.get(i))
                if inv4
                    b4 := not b4
                if b1 != b4
                    crack := true

            if crack
                if is_ph
                    psp.set(i, 1) // 1 = psp bear color
                if is_pl
                    psp.set(i, 2) // 2 = psp bull color
    psp

