indicator("Sam10", overlay = true,max_bars_back = 500, max_boxes_count = 500, max_lines_count=500, max_labels_count=500,  dynamic_requests = true)

// ~~ Inputs {
tf       = input.timeframe("D","Timeframe", group="Higher Timeframe Candles")
numb     = input.int(3,"Amount of Candles",minval=0, maxval=20, group="Higher Timeframe Candles")+1
dn_col   = input.color(color.new(color.black,10), title="Dn", inline="Candles", group="Higher Timeframe Candles")
dn_wick  = input.color(color.new(color.black,0), title="Wick", inline="Candles", group="Higher Timeframe Candles")
up_col   = input.color(color.new(#ffffff, 0), title="Up",inline="Candles", group="Higher Timeframe Candles")
up_wick  = input.color(color.new(color.black,0), title="Wick", inline="Candles", group="Higher Timeframe Candles")
Range    = input.bool(false,"Range High/Low", inline="range", group="Range")
Mid      = input.bool(true,"Range Mid", inline="range", group="Range")
high_col = input.color(color.rgb(139, 139, 139, 68), title="High", inline="range 1", group="Range")
low_col  = input.color(color.rgb(54, 58, 69, 69), title="Low",inline="range 1", group="Range")
mid_col  = input.color(color.rgb(120, 123, 134, 70), title="Mid",inline="range 1", group="Range")
loc      = input.int(3,"Location", group="Location Settings")
panel_spacing = input.int(15, "Panel Spacing (horizontal)", minval=2, maxval=40, group="Location Settings")
loc2 = loc + panel_spacing
loc3 = loc + panel_spacing * 2

// ~~ Table Inputs {
showTable      = input.bool(true,title="Show Table", inline="tbl", group="Table")
TblSize        = input.string(size.normal,title="",options=[size.auto,size.tiny,size.small,size.normal,size.large,size.huge],inline="tbl", group="Table")
pos            = input.string(position.top_right, title="",options =[position.top_right,position.top_center,
 position.top_left,position.bottom_right,position.bottom_center,position.bottom_left,position.middle_right,position.middle_left],inline="tbl", group="Table")
textcolor      = input.color(color.white, title="Text",inline="tbl_col", group="Table")
bgcolor        = input.color(color.new(color.black,30), title="Bg",inline="tbl_col", group="Table")
//~~~}
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~}

// ~~ New Feature Toggles (Extras)
n_extras = "Extras"
enable_all_toggles = input.bool(true, "Enable All New Features", group=n_extras)
enable_auto_htf = input.bool(true, "Auto-change HTF & Separators", group=n_extras, tooltip="Auto-map: 1m→15m, 5m→60m, 15m→4h, 30m→4h, 60m→D, 4h→W, D→1M")
enable_htf_countdown = input.bool(true, "HTF Candle Countdown", group=n_extras)

// Auto mapping function for HTF based on chart timeframe
auto_map_tf(chart_tf) =>
    ts = timeframe.in_seconds(chart_tf)
    switch ts
        60      => "15"     // 1min → 15min
        180     => "30"     // 3min → 30min
        300     => "60"     // 5min → 60min
        900     => "90"     // 15min → 90min
        1800    => "90"     // 30min → 90min
        3600    => "240"    // 60min → 4h
        14400   => "360"    // 4h → 6h
        86400   => "W"      // daily → weekly
        604800  => "M"      // weekly → monthly
        => chart_tf         // default: return as-is

// Auto mapping function for HTF panel 2 based on chart timeframe
auto_map_tf_p2(chart_tf) =>
    ts = timeframe.in_seconds(chart_tf)
    switch ts
        60      => "90"     // 1min → 90min
        180     => "90"     // 3min → 90min
        300     => "90"     // 5min → 90min
        900     => "240"    // 15min → 4h
        1800    => "360"    // 30min → 6h
        3600    => "360"    // 60min → 6h
        14400   => "D"      // 4h → daily
        86400   => "M"      // daily → monthly
        604800  => "M"      // weekly → monthly
        => chart_tf         // default: return as-is

// Auto mapping function for HTF panel 3 based on chart timeframe
auto_map_tf_p3(chart_tf) =>
    ts = timeframe.in_seconds(chart_tf)
    switch ts
        60      => "360"    // 1min → 6h
        180     => "360"    // 3min → 6h
        300     => "360"    // 5min → 6h
        900     => "D"      // 15min → daily
        1800    => "D"      // 30min → daily
        3600    => "D"      // 60min → daily
        14400   => "W"      // 4h → weekly
        86400   => "M"      // daily → monthly
        604800  => "M"      // weekly → monthly
        => chart_tf         // default: return as-is

// Auto mapping function for separators based on chart timeframe
auto_map_sep(chart_tf) =>
    ts = timeframe.in_seconds(chart_tf)
    if ts <= 60
        "15"
    else if ts <= 180
        "30"
    else if ts <= 300
        "60"
    else if ts <= 900
        "240"
    else if ts <= 3600
        "D"
    else if ts <= 14400
        "W"
    else if ts <= 604800
        "1M"
    else
        chart_tf

// Calculate effective HTF
htfCandTF = enable_all_toggles and enable_auto_htf ? auto_map_tf(timeframe.period) : tf
htfCandTF_p2 = enable_all_toggles and enable_auto_htf ? auto_map_tf_p2(timeframe.period) : tf
htfCandTF_p3 = enable_all_toggles and enable_auto_htf ? auto_map_tf_p3(timeframe.period) : tf

//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~}

// ~~ HTF Error Message {
tfs = str.tonumber(htfCandTF)
if str.tostring(htfCandTF) == "1D"
    tfs := 1440 
error = str.tonumber(timeframe.period)>=tfs
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~}

// ~~ UDT {
type HTF
    array<box> candle
    array<line> wickH
    array<line> wickL
    array<float> hl  
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~}

// ~~ Variables {
b = bar_index
var candle    = HTF.new(array.new<box>(numb),array.new<line>(numb),array.new<line>(numb),array.new<float>(numb*2))
[o,h,l,c]     = request.security(syminfo.tickerid,htfCandTF,[open,high,low,close],lookahead=barmerge.lookahead_on)
// Auto-mapped HTF series for panel 2
[o_p2,h_p2,l_p2,c_p2] = request.security(syminfo.tickerid, htfCandTF_p2, [open,high,low,close], lookahead=barmerge.lookahead_on)
// Auto-mapped HTF series for panel 3
[o_p3,h_p3,l_p3,c_p3] = request.security(syminfo.tickerid, htfCandTF_p3, [open,high,low,close], lookahead=barmerge.lookahead_on)

// Second HTF candle storage (panel 2)
var candle2 = HTF.new(array.new<box>(numb), array.new<line>(numb), array.new<line>(numb), array.new<float>(numb*2))
// Third HTF candle storage (panel 3)
var candle3 = HTF.new(array.new<box>(numb), array.new<line>(numb), array.new<line>(numb), array.new<float>(numb*2))

// ~~ HTF Countdown Label (positioned above HTF candles)
var label htfCountLbl = na
var label htfCountLbl_p2 = na
var label htfCountLbl_p3 = na
if enable_all_toggles and enable_htf_countdown and barstate.islast
    tfSecs = timeframe.in_seconds(htfCandTF)
    tfSecs := tfSecs == 0 ? 60 : tfSecs
    rem_ms = tfSecs * 1000 - (time % (tfSecs * 1000))
    rem_s = math.max(0, math.round(rem_ms / 1000))
    hrs = math.floor(rem_s / 3600)
    mins = math.floor((rem_s % 3600) / 60)
    secs = rem_s % 60
    hrsStr = hrs > 0 ? (hrs < 10 ? "0" + str.tostring(hrs) : str.tostring(hrs)) + ":" : ""
    minsStr = mins < 10 ? "0" + str.tostring(mins) : str.tostring(mins)
    secsStr = secs < 10 ? "0" + str.tostring(secs) : str.tostring(secs)
    tfLabel = str.tostring(htfCandTF)
    txt = "TF1: " + tfLabel + "\n[" + hrsStr + minsStr + ":" + secsStr + "]"
    // Position above HTF candles (using loc for x positioning and candle high for y)
    htfCandleX = b + numb * 4 + loc + numb
    htfCandleY = candle.hl.max() + (syminfo.mintick * 50)
    if na(htfCountLbl)
        htfCountLbl := label.new(htfCandleX, htfCandleY, txt, xloc=xloc.bar_index, yloc=yloc.price, style=label.style_label_down, color=color.new(color.white, 100), textcolor=color.black, size=size.small, text_font_family=font.family_monospace)
    else
        label.set_xy(htfCountLbl, htfCandleX, htfCandleY)
        label.set_text(htfCountLbl, txt)
        label.set_color(htfCountLbl, color.new(color.white, 100))
        label.set_textcolor(htfCountLbl, color.black)

    tfSecs_p2 = timeframe.in_seconds(htfCandTF_p2)
    tfSecs_p2 := tfSecs_p2 == 0 ? 60 : tfSecs_p2
    rem_ms_p2 = tfSecs_p2 * 1000 - (time % (tfSecs_p2 * 1000))
    rem_s_p2 = math.max(0, math.round(rem_ms_p2 / 1000))
    hrs_p2 = math.floor(rem_s_p2 / 3600)
    mins_p2 = math.floor((rem_s_p2 % 3600) / 60)
    secs_p2 = rem_s_p2 % 60
    hrsStr_p2 = hrs_p2 > 0 ? (hrs_p2 < 10 ? "0" + str.tostring(hrs_p2) : str.tostring(hrs_p2)) + ":" : ""
    minsStr_p2 = mins_p2 < 10 ? "0" + str.tostring(mins_p2) : str.tostring(mins_p2)
    secsStr_p2 = secs_p2 < 10 ? "0" + str.tostring(secs_p2) : str.tostring(secs_p2)
    txt_p2 = "TF2: " + str.tostring(htfCandTF_p2) + "\n[" + hrsStr_p2 + minsStr_p2 + ":" + secsStr_p2 + "]"
    htfCandleX_p2 = b + numb * 4 + loc2 + numb
    htfCandleY_p2 = candle2.hl.max() + (syminfo.mintick * 50)
    if na(htfCountLbl_p2)
        htfCountLbl_p2 := label.new(htfCandleX_p2, htfCandleY_p2, txt_p2, xloc=xloc.bar_index, yloc=yloc.price, style=label.style_label_down, color=color.new(color.white, 100), textcolor=color.black, size=size.small, text_font_family=font.family_monospace)
    else
        label.set_xy(htfCountLbl_p2, htfCandleX_p2, htfCandleY_p2)
        label.set_text(htfCountLbl_p2, txt_p2)
        label.set_color(htfCountLbl_p2, color.new(color.white, 100))
        label.set_textcolor(htfCountLbl_p2, color.black)

    tfSecs_p3 = timeframe.in_seconds(htfCandTF_p3)
    tfSecs_p3 := tfSecs_p3 == 0 ? 60 : tfSecs_p3
    rem_ms_p3 = tfSecs_p3 * 1000 - (time % (tfSecs_p3 * 1000))
    rem_s_p3 = math.max(0, math.round(rem_ms_p3 / 1000))
    hrs_p3 = math.floor(rem_s_p3 / 3600)
    mins_p3 = math.floor((rem_s_p3 % 3600) / 60)
    secs_p3 = rem_s_p3 % 60
    hrsStr_p3 = hrs_p3 > 0 ? (hrs_p3 < 10 ? "0" + str.tostring(hrs_p3) : str.tostring(hrs_p3)) + ":" : ""
    minsStr_p3 = mins_p3 < 10 ? "0" + str.tostring(mins_p3) : str.tostring(mins_p3)
    secsStr_p3 = secs_p3 < 10 ? "0" + str.tostring(secs_p3) : str.tostring(secs_p3)
    txt_p3 = "TF3: " + str.tostring(htfCandTF_p3) + "\n[" + hrsStr_p3 + minsStr_p3 + ":" + secsStr_p3 + "]"
    htfCandleX_p3 = b + numb * 4 + loc3 + numb
    htfCandleY_p3 = candle3.hl.max() + (syminfo.mintick * 50)
    if na(htfCountLbl_p3)
        htfCountLbl_p3 := label.new(htfCandleX_p3, htfCandleY_p3, txt_p3, xloc=xloc.bar_index, yloc=yloc.price, style=label.style_label_down, color=color.new(color.white, 100), textcolor=color.black, size=size.small, text_font_family=font.family_monospace)
    else
        label.set_xy(htfCountLbl_p3, htfCandleX_p3, htfCandleY_p3)
        label.set_text(htfCountLbl_p3, txt_p3)
        label.set_color(htfCountLbl_p3, color.new(color.white, 100))
        label.set_textcolor(htfCountLbl_p3, color.black)

//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~}

// ~~ Code {
if ta.change(o) //New candle declaration
    candle.candle.shift().delete()
    candle.wickH.shift().delete()
    candle.wickL.shift().delete()
    candle.hl.shift()
    candle.hl.shift()

    candle.candle.push(box.new(b+numb*4+loc,math.max(o,c),b+numb*4+loc+2,math.min(o,c),color.black,border_width=1,bgcolor=o>c?dn_col:up_col))
    candle.wickH.push(line.new(b+numb*4+loc+1,math.max(o,c),b+numb*4+loc+1,h,color=o>c?dn_col:up_col))
    candle.wickL.push(line.new(b+numb*4+loc+1,math.min(o,c),b+numb*4+loc+1,l,color=o>c?dn_col:up_col))
    candle.hl.push(h)
    candle.hl.push(l)
else // Relocate previous & current candles
    d = loc
    for [i,x] in candle.candle
        if i<numb-1
            x.set_left(b+d*2)
            x.set_right(b+d*2+2)
            candle.wickH.get(i).set_x1(b+d*2+1)
            candle.wickH.get(i).set_x2(b+d*2+1)
            candle.wickL.get(i).set_x1(b+d*2+1)
            candle.wickL.get(i).set_x2(b+d*2+1)
        else
            x.set_lefttop(b+d*2,math.max(o,c))
            x.set_rightbottom(b+d*2+2,math.min(o,c))
            x.set_bgcolor(o>c?dn_col:up_col)
            candle.wickH.get(i).set_xy1(b+d*2+1,math.max(o,c))
            candle.wickH.get(i).set_xy2(b+d*2+1,h)
            candle.wickH.get(i).set_color(o>c?dn_wick:up_wick)
            candle.wickL.get(i).set_xy1(b+d*2+1,math.min(o,c))
            candle.wickL.get(i).set_xy2(b+d*2+1,l)
            candle.wickL.get(i).set_color(o>c?dn_wick:up_wick)
            candle.hl.set(numb*2-2,h)
            candle.hl.set(numb*2-1,l)
        d += 2
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~}

// ~~ Panel 2: User-selected HTF candles (separate panel)
if ta.change(o_p2) //New candle declaration for panel2
    candle2.candle.shift().delete()
    candle2.wickH.shift().delete()
    candle2.wickL.shift().delete()
    candle2.hl.shift()
    candle2.hl.shift()

    candle2.candle.push(box.new(b+numb*4+loc2,math.max(o_p2,c_p2),b+numb*4+loc2+2,math.min(o_p2,c_p2),color.black,border_width=1,bgcolor=o_p2>c_p2?dn_col:up_col))
    candle2.wickH.push(line.new(b+numb*4+loc2+1,math.max(o_p2,c_p2),b+numb*4+loc2+1,h_p2,color=o_p2>c_p2?dn_col:up_col))
    candle2.wickL.push(line.new(b+numb*4+loc2+1,math.min(o_p2,c_p2),b+numb*4+loc2+1,l_p2,color=o_p2>c_p2?dn_col:up_col))
    candle2.hl.push(h_p2)
    candle2.hl.push(l_p2)
else // Relocate previous & current candles for panel2
    d2 = loc2
    for [i,x] in candle2.candle
        if i<numb-1
            x.set_left(b+d2*2)
            x.set_right(b+d2*2+2)
            candle2.wickH.get(i).set_x1(b+d2*2+1)
            candle2.wickH.get(i).set_x2(b+d2*2+1)
            candle2.wickL.get(i).set_x1(b+d2*2+1)
            candle2.wickL.get(i).set_x2(b+d2*2+1)
        else
            x.set_lefttop(b+d2*2,math.max(o_p2,c_p2))
            x.set_rightbottom(b+d2*2+2,math.min(o_p2,c_p2))
            x.set_bgcolor(o_p2>c_p2?dn_col:up_col)
            candle2.wickH.get(i).set_xy1(b+d2*2+1,math.max(o_p2,c_p2))
            candle2.wickH.get(i).set_xy2(b+d2*2+1,h_p2)
            candle2.wickH.get(i).set_color(o_p2>c_p2?dn_wick:up_wick)
            candle2.wickL.get(i).set_xy1(b+d2*2+1,math.min(o_p2,c_p2))
            candle2.wickL.get(i).set_xy2(b+d2*2+1,l_p2)
            candle2.wickL.get(i).set_color(o_p2>c_p2?dn_wick:up_wick)
            candle2.hl.set(numb*2-2,h_p2)
            candle2.hl.set(numb*2-1,l_p2)
        d2 += 2

if ta.change(o_p3) //New candle declaration for panel3
    candle3.candle.shift().delete()
    candle3.wickH.shift().delete()
    candle3.wickL.shift().delete()
    candle3.hl.shift()
    candle3.hl.shift()

    candle3.candle.push(box.new(b+numb*4+loc3,math.max(o_p3,c_p3),b+numb*4+loc3+2,math.min(o_p3,c_p3),color.black,border_width=1,bgcolor=o_p3>c_p3?dn_col:up_col))
    candle3.wickH.push(line.new(b+numb*4+loc3+1,math.max(o_p3,c_p3),b+numb*4+loc3+1,h_p3,color=o_p3>c_p3?dn_col:up_col))
    candle3.wickL.push(line.new(b+numb*4+loc3+1,math.min(o_p3,c_p3),b+numb*4+loc3+1,l_p3,color=o_p3>c_p3?dn_col:up_col))
    candle3.hl.push(h_p3)
    candle3.hl.push(l_p3)
else
    d3 = loc3
    for [i,x] in candle3.candle
        if i<numb-1
            x.set_left(b+d3*2)
            x.set_right(b+d3*2+2)
            candle3.wickH.get(i).set_x1(b+d3*2+1)
            candle3.wickH.get(i).set_x2(b+d3*2+1)
            candle3.wickL.get(i).set_x1(b+d3*2+1)
            candle3.wickL.get(i).set_x2(b+d3*2+1)
        else
            x.set_lefttop(b+d3*2,math.max(o_p3,c_p3))
            x.set_rightbottom(b+d3*2+2,math.min(o_p3,c_p3))
            x.set_bgcolor(o_p3>c_p3?dn_col:up_col)
            candle3.wickH.get(i).set_xy1(b+d3*2+1,math.max(o_p3,c_p3))
            candle3.wickH.get(i).set_xy2(b+d3*2+1,h_p3)
            candle3.wickH.get(i).set_color(o_p3>c_p3?dn_wick:up_wick)
            candle3.wickL.get(i).set_xy1(b+d3*2+1,math.min(o_p3,c_p3))
            candle3.wickL.get(i).set_xy2(b+d3*2+1,l_p3)
            candle3.wickL.get(i).set_color(o_p3>c_p3?dn_wick:up_wick)
            candle3.hl.set(numb*2-2,h_p3)
            candle3.hl.set(numb*2-1,l_p3)
        d3 += 2

// ~~ Range {
if Range
    RangeHigh  = line.new(b,candle.hl.max(),b+numb*4+loc+2,candle.hl.max(),color=high_col,extend=extend.none)
    RangeLow   = line.new(b,candle.hl.min(),b+numb*4+loc+2,candle.hl.min(),color=low_col,extend=extend.none)
    (RangeHigh[1]).delete()
    (RangeLow[1]).delete()

if Mid    
    RangeMid = line.new(b,math.avg(candle.hl.max(),candle.hl.min()),b+numb*4+loc+2,math.avg(candle.hl.max(),candle.hl.min()),color=mid_col,extend=extend.none)
    (RangeMid[1]).delete()

//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~}

// Inputs
sepColorInput    = input.color   (color.rgb(119, 119, 119, 40),    "Separator Color")
sepStyleInput    = input.string  ("Dotted",      "Separator Style", options = ["Solid", "Dashed", "Dotted"])
sepWidthInput    = input.int     (1,             "Separator Width", minval = 1)
sepTimeframeInput = input.timeframe("60", "Separator Timeframe Manual Override", tooltip="When auto-map is enabled, this is overridden by auto mapping function")

// Calculate effective separator timeframe based on auto-HTF mapping
sepEffective = enable_all_toggles and enable_auto_htf ? auto_map_sep(timeframe.period) : sepTimeframeInput

// Function to get the line style
getLineStyle(string input) =>
    switch input
        "Solid"  => line.style_solid
        "Dashed" => line.style_dashed
        "Dotted" => line.style_dotted

// Function to draw the period separator
drawPeriodSeparator(color color, string style, int width, string tfm) =>
    if timeframe.change(tfm)
        line.new(
             x1     = bar_index,
             x2     = bar_index,
             y1     = high + syminfo.mintick,
             y2     = low,
             extend = extend.both,
             color  = color,
             style  = getLineStyle(style),
             width  = width
             )

// Draw the period separator based on the auto-mapped or selected timeframe
if timeframe.in_seconds(timeframe.period) <= timeframe.in_seconds(sepEffective)
    drawPeriodSeparator(sepColorInput, sepStyleInput, sepWidthInput, sepEffective)

