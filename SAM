bullDivCss = input.color(#000000, 'Swing High', group = 'Style')
bearDivCss = input.color(#000000, 'Swing Low', group = 'Style')

//Dashboard
showDash = input(false, 'Show Dashboard'                                                               , group = 'Dashboard')
dashLoc  = input.string('Top Right', 'Location', options = ['Top Right', 'Bottom Right', 'Bottom Left'], group = 'Dashboard')
textSize = input.string('Small', 'Size'        , options = ['Tiny', 'Small', 'Normal']                 , group = 'Dashboard')
showOpenStatus = input.bool(true, 'Show Open Status', group = 'Dashboard')
show90mSSMT = input.bool(true, 'Show 90m SSMT Pair Code', group = 'Dashboard')
showOpenStatusDashboard = input.bool(false, 'Show SBTNC Open Status Dashboard', group = 'Dashboard')
showOpenLines = input.bool(false, 'Show 6H/90M Open Lines', group = 'Dashboard')
showSessionsDash = input.bool(true, 'Show Sessions Dashboard', group = 'Dashboard')

//-----------------------------------------------------------------------------}
//Function
//-----------------------------------------------------------------------------{
n_stamp = bar_index

get_hl() => [high, low, close]

//Swing highs divergences
get_divergence(ph, y2, sym_y2, css)=>
    var float y1 = na
    var float sym_y1 = na
    var int x1 = na
    var smt = 0

    if y2 != y2[1] and sym_y2 != sym_y2[1] 
        //Test for SMT
        if (y2 - y1) * (sym_y2 - sym_y1) < 0
            line.new(n_stamp[length], y2, x1, y1, color = css)

            smt += 1
        
        sym_y1 := sym_y2
        y1 := y2
        x1 := n_stamp[length]
    else if (ph and y2 > y2[1]) or (not ph and y2 < y2[1]) 
        sym_y1 := na
        y1 := y2
        x1 := n_stamp[length]
    
    smt

//-----------------------------------------------------------------------------}
//Main variables
//-----------------------------------------------------------------------------{
var phN = 0, var plN = 0
var ph_smt1 = 0.
var pl_smt1 = 0.
var ph_smt2 = 0.
var pl_smt2 = 0.

ticker1 = syminfo.ticker(sym1)
ticker2 = syminfo.ticker(sym2)

//-----------------------------------------------------------------------------}
//Detect swing highs/lows and divergences
//-----------------------------------------------------------------------------{
ph = fixnan(ta.pivothigh(length, length))
pl = fixnan(ta.pivotlow(length, length))
phN += ph != ph[1] ? 1 : 0
plN += pl != pl[1] ? 1 : 0

//Comparison symbol pivots
[h1, l1, c1] = request.security(sym1, timeframe.period, get_hl())
[h2, l2, c2] = request.security(sym2, timeframe.period, get_hl())

//Detect swing high divergences
if useSym1
    sym_ph1 = fixnan(ta.pivothigh(h1, length, length))
    sym_pl1 = fixnan(ta.pivotlow(l1, length, length))

    ph_smt1 := get_divergence(true, ph, sym_ph1, bullDivCss)
    pl_smt1 := get_divergence(false, pl, sym_pl1, bearDivCss)

if useSym2
    sym_ph2 = fixnan(ta.pivothigh(h2, length, length))
    sym_pl2 = fixnan(ta.pivotlow(l2, length, length))
    
    ph_smt2 := get_divergence(true, ph, sym_ph2, bullDivCss)
    pl_smt2 := get_divergence(false, pl, sym_pl2, bearDivCss)

txt = ''
if ph != ph[1]
    if ph_smt1 > ph_smt1[1]
        txt += ticker1
    if ph_smt2 > ph_smt2[1]
        txt += txt != '' ? ' | ' : ''
        txt += ticker2

        if txt != ''
            label.new(n_stamp[length], ph, txt, color=color.new(color.white, 100), style=label.style_label_down, textcolor=bullDivCss, size=size.tiny)
else
    if pl_smt1 > pl_smt1[1]
        txt += ticker1
    if pl_smt2 > pl_smt2[1]
        txt += txt != '' ? ' | ' : ''
        txt += ticker2

        if txt != ''
            label.new(n_stamp[length], pl, txt, color=color.new(color.white, 100), style=label.style_label_up, textcolor=bearDivCss, size=size.tiny)
    
//-----------------------------------------------------------------------------}
//Tables
//-----------------------------------------------------------------------------{
var table_position = dashLoc == 'Bottom Left' ? position.bottom_left 
  : dashLoc == 'Top Right' ? position.top_right 
  : position.bottom_right

var table_size = textSize == 'Tiny' ? size.tiny 
  : textSize == 'Small' ? size.small 
  : size.normal

var tb = table.new(table_position, 7, 3
  , bgcolor = #1e222d
  , border_color = #373a46
  , border_width = 1
  , frame_color = #373a46
  , frame_width = 1)

pairText = ''
if useSym1
    pairText := ticker1
if useSym2
    pairText := pairText != '' ? pairText + ' | ' + ticker2 : ticker2
pairText := pairText == '' ? syminfo.ticker : pairText

// SBTNC Open statuses
tickerId = ticker.new(syminfo.prefix, syminfo.ticker, session.regular)
[_d1t, d1_open]   = request.security(tickerId, "D",   [time, open], lookahead = barmerge.lookahead_on)
[_w1t, w1_open]   = request.security(tickerId, "W",   [time, open], lookahead = barmerge.lookahead_on)
[_h6t, h6_open]   = request.security(tickerId, "360", [time, open], lookahead = barmerge.lookahead_on)
[_m90t, m90_open] = request.security(tickerId, "90",  [time, open], lookahead = barmerge.lookahead_on)

// Fallback if the 6H or 90M open is not available in the current feed.
h6_open_fallback  = na(h6_open)  ? open : h6_open
m90_open_fallback = na(m90_open) ? open : m90_open

dailyStatus   = close > d1_open ? 'Above' : close < d1_open ? 'Below' : 'At'
weeklyStatus  = close > w1_open ? 'Above' : close < w1_open ? 'Below' : 'At'
h6Status      = close > h6_open_fallback ? 'Above' : close < h6_open_fallback ? 'Below' : 'At'
m90Status     = close > m90_open_fallback ? 'Above' : close < m90_open_fallback ? 'Below' : 'At'

statusColor(openLevel) =>
    close > openLevel ? color.lime : close < openLevel ? color.red : color.silver

if barstate.isfirst and (showDash or showOpenStatusDashboard)
    tb.cell(0, 0, '', text_color = color.white)
    tb.cell(0, 1, showDash ? ticker1 : syminfo.ticker, text_color = color.white)
    tb.cell(0, 2, showDash ? ticker2 : '', text_color = color.white)

    tb.cell(1, 0, 'Swing High', text_color = color.white)
    tb.cell(2, 0, 'Swing Low', text_color = color.white)
    tb.cell(3, 0, 'Daily Open', text_color = color.white)
    tb.cell(4, 0, 'Weekly Open', text_color = color.white)
    tb.cell(5, 0, '6H Open', text_color = color.white)
    tb.cell(6, 0, '90M Open', text_color = color.white)
    
    if showDash
        tb.cell(0, 1, ticker1, text_color = color.white)
        tb.cell(0, 2, ticker2, text_color = color.white)

if barstate.islast and (showDash or showOpenStatusDashboard)
    if showDash
        //Symbol 1
        tb.cell(1, 1, str.format('{0} ({1, number, percent})', ph_smt1, ph_smt1 / phN)
          , text_color = bullDivCss)
        tb.cell(2, 1, str.format('{0} ({1, number, percent})', pl_smt1, pl_smt1 / plN)
          , text_color = bearDivCss)
        
        //Symbol 2
        tb.cell(1, 2, str.format('{0} ({1, number, percent})', ph_smt2, ph_smt2 / phN)
          , text_color = bullDivCss)
        tb.cell(2, 2, str.format('{0} ({1, number, percent})', pl_smt2, pl_smt2 / plN)
          , text_color = bearDivCss)

    if showOpenStatusDashboard
        tb.cell(3, 1, dailyStatus,  text_color = statusColor(d1_open))
        tb.cell(4, 1, weeklyStatus, text_color = statusColor(w1_open))
        tb.cell(5, 1, h6Status,     text_color = statusColor(h6_open))
        tb.cell(6, 1, m90Status,    text_color = statusColor(m90_open))
        tb.cell(3, 2, show90mSSMT ? pairText : '', text_color = color.white)
        tb.cell(4, 2, '', text_color = color.white)
        tb.cell(5, 2, '', text_color = color.white)
        tb.cell(6, 2, '', text_color = color.white)

// 6H and 90M open lines removed — set to na always
plot(na, title = "6H Open Line", editable = false)
plot(na, title = "90M Open Line", editable = false)

// Get 90M and 6H SSMT data (Smart Money Tape pair correlation)
show90m6hrSMT = input.bool(true, 'Show 90m/6hr SMT SSMT', group = 'Dashboard')

[_90m_time, _90m_open, _90m_high, _90m_low]   = request.security(tickerId, "90",  [time, open, high, low], lookahead = barmerge.lookahead_on)
[_6h_time, _6h_open, _6h_high, _6h_low]       = request.security(tickerId, "360", [time, open, high, low], lookahead = barmerge.lookahead_on)

// Determine 90M SSMT status (above/below high/low)
smt90_status = close > _90m_high ? 'Above' : close < _90m_low ? 'Below' : 'Mid'
smt6h_status = close > _6h_high ? 'Above' : close < _6h_low ? 'Below' : 'Mid'

smt_status_color(status_val) =>
    status_val == 'Above' ? color.lime : status_val == 'Below' ? color.red : color.silver

//------------------------------------------------------------------------------
// © SESSIONS PIPS DASHBOARD (transparent, tiny, single toggle)
//------------------------------------------------------------------------------
enableSessionsPips = input.bool(true, 'Show Sessions Pips Dashboard', group = 'Dashboard')
showSessionsPipsTable = input.bool(true, 'Show Sessions Pips Table', group = 'Dashboard')
showQuarterlyBreakdown = input.bool(true, 'Show Quarterly Pips Breakdown', group = 'Dashboard')

// Get current timeframe in minutes
_cur_tf_mins = timeframe.in_seconds() / 60

// Get session data for 90M and 6H ranges
[_90m_sess_high, _90m_sess_low] = request.security(tickerId, "90", [high, low], lookahead = barmerge.lookahead_on)
[_6h_sess_high, _6h_sess_low]   = request.security(tickerId, "360", [high, low], lookahead = barmerge.lookahead_on)

// Get quarterly 90M ranges (4 × 90m = 360m = 6h)
ms90m   = 90 * 60 * 1000
sessStartMs = time - ((time % ms90m))  // Align to 90m boundary
quarterIdx = math.floor(((time - sessStartMs) % (4 * ms90m)) / ms90m)

[_q1_h90, _q1_l90] = request.security(tickerId, "90", [high, low], lookahead = barmerge.lookahead_on)

// Calculate pips (in mintick units for display purposes)
f_calc_pips(float h, float l) =>
    h > l ? math.round(math.abs(h - l) / syminfo.mintick) : 0

// On lower TF (1m, 3m, 5m): show 90M quarterly range pips
// On higher TF (15m, 30m): show 6H Q1 Q2 Q3 Q4 range pips
sess_pips_range = _cur_tf_mins <= 5 ? f_calc_pips(_90m_sess_high, _90m_sess_low) : 
                  _cur_tf_mins <= 30 ? f_calc_pips(_6h_sess_high, _6h_sess_low) : 
                  na

// Current quarter context label
quart_label = _cur_tf_mins <= 5 ? 'Q' + str.tostring(quarterIdx + 1) : 'Q[6H]'

// Create sessions pips dashboard table — transparent bg, tiny text, updated every bar
var table sessTable = na
if showSessionsDash and barstate.islast
    if na(sessTable)
        sessTable := table.new(position.top_right, 4, 4, 
                               bgcolor = color.new(color.black, 100),
                               border_color = color.new(color.gray, 80),
                               border_width = 0,
                               frame_color = color.new(color.gray, 100),
                               frame_width = 0)

    // Header row
    table.cell(sessTable, 0, 0, 'Sessions',     bgcolor = color.new(color.black, 100), text_color = color.silver, text_size = size.small)
    table.cell(sessTable, 1, 0, 'Range Pips',   bgcolor = color.new(color.black, 100), text_color = color.silver, text_size = size.small)
    table.cell(sessTable, 2, 0, 'SMT Status',   bgcolor = color.new(color.black, 100), text_color = color.silver, text_size = size.small)
    table.cell(sessTable, 3, 0, 'Daily',        bgcolor = color.new(color.black, 100), text_color = color.silver, text_size = size.small)
    
    // Current session row
    table.cell(sessTable, 0, 1, _cur_tf_mins <= 5 ? '90M ' + quart_label : _cur_tf_mins <= 30 ? '6H ' + quart_label : 'HTF', 
               bgcolor = color.new(color.black, 100), text_color = color.silver, text_size = size.small)
    table.cell(sessTable, 1, 1, str.tostring(sess_pips_range) + ' pips', 
               bgcolor = color.new(color.black, 100), text_color = sess_pips_range > 50 ? color.lime : sess_pips_range > 20 ? color.yellow : color.orange, text_size = size.small)
    
    // 90M/6H SSMT status
    table.cell(sessTable, 2, 1, smt90_status, bgcolor = color.new(color.black, 100), text_color = smt_status_color(smt90_status), text_size = size.small)
    table.cell(sessTable, 3, 1, dailyStatus,  bgcolor = color.new(color.black, 100), text_color = close > d1_open ? color.lime : color.red, text_size = size.small)
    
    // Weekly status row
    table.cell(sessTable, 0, 2, 'Weekly',       bgcolor = color.new(color.black, 100), text_color = color.silver, text_size = size.small)
    table.cell(sessTable, 1, 2, weeklyStatus,   bgcolor = color.new(color.black, 100), text_color = close > w1_open ? color.lime : color.red, text_size = size.small)
    table.cell(sessTable, 2, 2, smt6h_status,   bgcolor = color.new(color.black, 100), text_color = smt_status_color(smt6h_status), text_size = size.small)
    table.cell(sessTable, 3, 2, h6Status,       bgcolor = color.new(color.black, 100), text_color = close > h6_open_fallback ? color.lime : color.red, text_size = size.small)
    
    // 90M status row
    table.cell(sessTable, 0, 3, '90M Status',   bgcolor = color.new(color.black, 100), text_color = color.silver, text_size = size.small)
    table.cell(sessTable, 1, 3, m90Status,      bgcolor = color.new(color.black, 100), text_color = close > m90_open_fallback ? color.lime : color.red, text_size = size.small)
    table.cell(sessTable, 2, 3, 'Qty: ' + quart_label, bgcolor = color.new(color.black, 100), text_color = color.orange, text_size = size.small)
    table.cell(sessTable, 3, 3, show90mSSMT ? pairText : '—', bgcolor = color.new(color.black, 100), text_color = color.aqua, text_size = size.small)

