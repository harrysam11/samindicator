tf_multi(tf) =>
    ts = timeframe.in_seconds("")
    htfs = timeframe.in_seconds(tf)
    htfs/ts

display_limit_line(_array) =>
    if array.size(_array) > displayLimit/2
        a = array.shift(_array)
        line.delete(a)

display_limit_box(_array) =>
    if array.size(_array) > displayLimit/2
        a = array.shift(_array)
        box.delete(a)

remove_mitigated_lines(_array, _hl) =>
    m = false
    if array.size(_array) > 0 and removeMitigated        
        for i = array.size(_array) - 1 to 0 by 1
            lineObj = array.get(_array, i)
            hh = _candleType == "Close" ? close[1] : high
            ll = _candleType == "Close" ? close[1] : low
            if _hl == "High" and hh > line.get_y1(lineObj)
                array.remove(_array, i)
                if mitiOptions == "Show"
                    line.new(line.get_x1(lineObj),line.get_y1(lineObj),time,line.get_y1(lineObj), xloc=xloc.bar_time, color = color.new(highLineColor, 70))
                line.delete(lineObj)
                m := true
            if _hl == "Low" and ll < line.get_y1(lineObj)
                array.remove(_array, i)
                if mitiOptions == "Show"
                    line.new(line.get_x1(lineObj),line.get_y1(lineObj),time,line.get_y1(lineObj), xloc=xloc.bar_time, color = color.new(lowLineColor, 70))
                line.delete(lineObj) 
                m := true  
    display_limit_line(_array) 
    m

remove_mitigated_boxes(_array, _hl) =>
    m = false
    if array.size(_array) > 0 and removeMitigated
        for i = array.size(_array) - 1 to 0 by 1
            boxObj = array.get(_array, i)
            hh = _candleType == "Close" ? close[1] : high
            ll = _candleType == "Close" ? close[1] : low
            if _hl == "High" and hh > box.get_top(boxObj)
                array.remove(_array, i)
                if mitiOptions == "Show"
                    box.new(box.get_left(boxObj),box.get_top(boxObj),time,box.get_bottom(boxObj), xloc=xloc.bar_time, bgcolor = color.new(highBoxBgColor, 90), border_color = color.new(highBoxBorderColor, 90), border_style = highLineStyle)
                box.delete(boxObj)
                m := true
            if _hl == "Low" and ll < box.get_top(boxObj)
                array.remove(_array, i)
                if mitiOptions == "Show"
                    box.new(box.get_left(boxObj),box.get_top(boxObj),time,box.get_bottom(boxObj), xloc=xloc.bar_time, bgcolor = color.new(lowBoxBgColor, 90), border_color = color.new(lowBoxBorderColor, 90), border_style = lowLineStyle)
                box.delete(boxObj)
                m := true
    display_limit_box(_array) 
    m

extend_line_to_current(lineArray) =>
    if array.size(lineArray) > 0
        for i = array.size(lineArray) - 1 to 0 by 1
            lineObj = array.get(lineArray, i)
            timeExt = time + ((time[1]-time[2])*20)
            line.set_x2(lineObj, timeExt)

extend_box_to_current(boxArray) =>
    if array.size(boxArray) > 0
        for i = array.size(boxArray) - 1 to 0 by 1
            boxObj = array.get(boxArray, i)
            timeExt = time + ((time[1]-time[2])*20)
            box.set_right(boxObj, timeExt)

