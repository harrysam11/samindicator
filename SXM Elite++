//// Auto mapping function for HTF based on chart timeframe
auto_map_tf(string chart_tf) =>
    float ts = timeframe.in_seconds(chart_tf)
    string mapped = chart_tf
    if ts <= 60
        mapped := "15"
    else if ts <= 180
        mapped := "30"
    else if ts <= 300
        mapped := "60"
    else if ts <= 900
        mapped := "240"
    else if ts <= 3600
        mapped := "D"
    else if ts <= 14400
        mapped := "W"
    else if ts <= 604800
        mapped := "1M"
    mapped

// Inputs
toggle_sep        = input.bool    (true,          "Show Period Separator")
sepColorInput     = input.color   (color.rgb(61, 61, 61),    "Separator Color")
sepStyleInput     = input.string  ("Dotted",      "Separator Style", options = ["Solid", "Dashed", "Dotted"])
sepWidthInput     = input.int     (1,             "Separator Width", minval = 1)
sepTimeframeInput = input.string  ("Auto",        "Separator Timeframe (Auto uses fractal)", options = ["Auto", "1", "3", "5", "15", "30", "45", "60", "120", "180", "240", "D", "W", "1M"])  // Timeframe for the separator

// Function to get the line style
getLineStyle(string input) =>
    switch input
        "Solid"  => line.style_solid
        "Dashed" => line.style_dashed
        "Dotted" => line.style_dotted

// Function to draw the period separator
drawPeriodSeparator(color color, string style, int width, string timeframe) =>
    if timeframe.change(timeframe)
        line.new(
             x1     = bar_index,
             x2     = bar_index,
             y1     = high + syminfo.mintick,
             y2     = low,
             extend = extend.both,
             color  = color,
             style  = getLineStyle(style),
             width  = width
             )

// Draw the period separator based on the selected timeframe and visible on the same or lower timeframes
mapped_sep_tf = sepTimeframeInput == "Auto" ? auto_map_tf(timeframe.period) : sepTimeframeInput
if toggle_sep and timeframe.in_seconds(timeframe.period) <= timeframe.in_seconds(mapped_sep_tf)
    drawPeriodSeparator(sepColorInput, sepStyleInput, sepWidthInput, mapped_sep_tf)




