isValidHTF(int target_mins) =>
    timeframe.in_seconds() <= target_mins * 60

calcMidpoint(float h, float l, float o, float c) =>
    float lh = math.log(h)
    float ll = math.log(l)
    float lo = math.log(o)
    float lc = math.log(c)
    float uw = lh - math.max(lo, lc)
    float lw = math.min(lo, lc) - ll
    float bs = math.abs(lc - lo)
    float lmid = math.max(uw, lw) > bs ? (uw > lw ? lh - uw / 2 : ll + lw / 2) : (lh + ll) / 2
    math.exp(lmid)

formatTime(int t) =>
    str.format_time(t, "HH:mm", "America/New_York")

remainingCustomTime(int openTime, int target_mins) =>
    if barstate.isrealtime and not na(openTime)
        int closeTime = openTime + (target_mins * 60000)
        int rem = math.max(0, int((closeTime - timenow) / 1000))
        if rem == 0
            '00:00'
        else
            int d = int(rem / 86400)
            int h = int((rem - d * 86400) / 3600)
            int m = int((rem - d * 86400 - h * 3600) / 60)
            int s = int(rem - d * 86400 - h * 3600 - m * 60)
            string r = str.tostring(s, '00')
            if m > 0 or h > 0 or d > 0
                r := str.tostring(m, '00') + ':' + r
            if h > 0 or d > 0
                r := str.tostring(h, '00') + ':' + r
            if d > 0
                r := str.tostring(d) + 'D ' + r
            r
    else
        'n/a'

get_line_style2(string s) =>
    s == "----" ? line.style_dashed : s == "····" ? line.style_dotted : line.style_solid

