//========================
// Helpers (Body-only)
//========================
bodyHigh(offset) =>
    math.max(open[offset], close[offset])

bodyLow(offset) =>
    math.min(open[offset], close[offset])

bodySize(offset) =>
    math.abs(close[offset] - open[offset])

//========================
// Types
//========================
type MarketStructure
    float topPrice
    float bottomPrice
    bool  isBullish

type cisd
    line level
    label txt
    bool completed

//========================
// Vars
//========================
var line lastTopLine    = na
var line lastBottomLine = na

// init market structure with BODY extremes, not wicks
var MarketStructure currentStructure = MarketStructure.new(math.max(open, close), math.min(open, close), close >= open)

var cisdLevelsBu = array.new<cisd>()  // bullish CISD levels (below price usually)
var cisdLevelsBe = array.new<cisd>()  // bearish CISD levels (above price usually)

var bool  isBullishPullback   = false
var bool  isBearishPullback   = false

var float potentialTopPrice    = na   // taken from opens (body)
var float potentialBottomPrice = na   // taken from opens (body)

var int   bullishBreakIndex   = na
var int   bearishBreakIndex   = na

var bool  currentState        = false  // false = bearish, true = bullish

//========================
// Pullback Detection (body-based, with size filter)
//========================

// minimum size of pullback body vs previous body (hardcoded: 50%)
minPullbackRatio = 0.5

pullbackBody = bodySize(1)
prevBody     = bodySize(2)
validPullback = prevBody > 0 and pullbackBody >= minPullbackRatio * prevBody

// green body = bearish pullback, red body = bullish pullback, only if big enough
bearishPullbackDetected = validPullback and close[1] > open[1]
bullishPullbackDetected = validPullback and close[1] < open[1]

// Bearish Pullback Logic
if bearishPullbackDetected and not isBearishPullback
    isBearishPullback := true
    potentialTopPrice := open[1]       // body-based anchor
    bullishBreakIndex := bar_index[1]

// Bullish Pullback Logic
if bullishPullbackDetected and not isBullishPullback
    isBullishPullback    := true
    potentialBottomPrice := open[1]    // body-based anchor
    bearishBreakIndex    := bar_index[1]

// Update Potential Levels During Pullbacks (body only)
if isBullishPullback
    // New lower body → update bottom anchor
    if open < potentialBottomPrice
        potentialBottomPrice := open
        bearishBreakIndex    := bar_index
    // Red candle with higher open than current bottom → shift anchor to that open
    if (close < open) and (open > potentialBottomPrice)
        potentialBottomPrice := open
        bearishBreakIndex    := bar_index     

if isBearishPullback
    // New higher open → update top anchor
    if open > potentialTopPrice
        potentialTopPrice := open
        bullishBreakIndex := bar_index
    // Green candle with lower open than current top → shift anchor to that open
    if (close > open) and open < potentialTopPrice
        potentialTopPrice := open
        bullishBreakIndex := bar_index      

//========================
// Structure Updates - Bearish Break (BODY ONLY)
//========================
if bodyLow(0) < currentStructure.bottomPrice
    currentStructure.bottomPrice := bodyLow(0)
    currentStructure.isBullish   := false
    
    if isBearishPullback and (bar_index - bullishBreakIndex != 0)
        idxBack  = bar_index - bullishBreakIndex
        idxBack1 = idxBack + 1
        top1 = bodyHigh(idxBack)
        top2 = bodyHigh(idxBack1)
        currentStructure.topPrice := math.max(top1, top2)

        isBearishPullback := false

        bearishLine  = line.new(bullishBreakIndex, potentialTopPrice, bar_index + lookAheadBars, potentialTopPrice, color = bullishBreakColor, width = lineWidth, style = lineStyle)
        bearishLabel = label.new(bar_index + lookAheadBars, potentialTopPrice, bullStr, color = color.new(color.white, 100), textcolor = bullishBreakColor, style = label.style_label_left, text_font_family = font.family_default, size = size.small, text_formatting = text.format_italic)
        b = cisd.new(bearishLine, bearishLabel, false)
        array.push(cisdLevelsBe, b)
    else if close[1] > open[1] and close < open
        currentStructure.topPrice := bodyHigh(1)
        isBearishPullback := false

        bearishLine  = line.new(bullishBreakIndex, potentialTopPrice, bar_index + lookAheadBars, potentialTopPrice, color = bullishBreakColor, width = lineWidth, style = lineStyle)
        bearishLabel = label.new(bar_index + lookAheadBars, potentialTopPrice, bullStr, color = color.new(color.white, 100), textcolor = bullishBreakColor, style = label.style_label_left, text_font_family = font.family_default, size = size.small, text_formatting = text.format_italic)
        b = cisd.new(bearishLine, bearishLabel, false)
        array.push(cisdLevelsBe, b)

//========================
// Structure Updates - Bullish Break (BODY ONLY)
//========================
if bodyHigh(0) > currentStructure.topPrice
    currentStructure.isBullish := true
    currentStructure.topPrice  := bodyHigh(0)
    
    if isBullishPullback and (bar_index - bearishBreakIndex != 0)
        idxBack  = bar_index - bearishBreakIndex
        idxBack1 = idxBack + 1
        bot1 = bodyLow(idxBack)
        bot2 = bodyLow(idxBack1)
        currentStructure.bottomPrice := math.min(bot1, bot2)

        isBullishPullback := false

        bullishLine  = line.new(bearishBreakIndex, potentialBottomPrice, bar_index + lookAheadBars, potentialBottomPrice, color = bearishBreakColor, width = lineWidth, style = lineStyle)
        bullishLabel = label.new(bar_index + lookAheadBars, potentialBottomPrice, bearStr, color = color.new(color.white, 100), textcolor = bearishBreakColor, style = label.style_label_left, text_font_family = font.family_default, size = size.small, text_formatting = text.format_italic)
        bu = cisd.new(bullishLine, bullishLabel, false)
        array.push(cisdLevelsBu, bu)
    else if close[1] < open[1] and close > open
        currentStructure.bottomPrice := bodyLow(1)
        isBullishPullback := false

        bullishLine  = line.new(bearishBreakIndex, potentialBottomPrice, bar_index + lookAheadBars, potentialBottomPrice, color = bearishBreakColor, width = lineWidth, style = lineStyle)
        bullishLabel = label.new(bar_index + lookAheadBars, potentialBottomPrice, bearStr, color = color.new(color.white, 100), textcolor = bearishBreakColor, style = label.style_label_left, text_font_family = font.family_default, size = size.small, text_formatting = text.format_italic)
        bu = cisd.new(bullishLine, bullishLabel, false)
        array.push(cisdLevelsBu, bu)

//========================
// Level cleanup (keep latest only)
//========================
if array.size(cisdLevelsBu) > 1 and not keepLevels
    oldestBu = array.shift(cisdLevelsBu)
    line.delete(oldestBu.level)
    label.delete(oldestBu.txt)

if array.size(cisdLevelsBe) > 1 and not keepLevels
    oldestBe = array.shift(cisdLevelsBe)
    line.delete(oldestBe.level)
    label.delete(oldestBe.txt)

//========================
// Manage bullish CISD (below price)
//========================
if array.size(cisdLevelsBu) >= 1
    latestBuIndex = array.size(cisdLevelsBu) - 1
    latestBu      = array.get(cisdLevelsBu, latestBuIndex)

    // As long as body low is not below CISD, extend the line
    if not (bodyLow(0) < latestBu.level.get_y2()) and not latestBu.completed
        line.set_x2(latestBu.level, bar_index + lookAheadBars)
        label.set_x(latestBu.txt, bar_index + lookAheadBars)

    // Break: body low closes below CISD
    if bodyLow(0) < latestBu.level.get_y2() and not latestBu.completed
        latestBu.completed := true
        array.set(cisdLevelsBu, latestBuIndex, latestBu)

        // Spawn new bearish CISD from current top anchor
        bearishLine  = line.new(bullishBreakIndex, potentialTopPrice, bar_index + lookAheadBars, potentialTopPrice, color = bullishBreakColor, width = lineWidth, style = lineStyle)
        bearishLabel = label.new(bar_index + lookAheadBars, potentialTopPrice, bullStr, color = color.new(color.white, 100), textcolor = bullishBreakColor, style = label.style_label_left, text_font_family = font.family_monospace, size = size.small, text_formatting = text.format_italic)
        b = cisd.new(bearishLine, bearishLabel, false)
        array.push(cisdLevelsBe, b)

        currentState := false

//========================
// Manage bearish CISD (above price)
//========================
if array.size(cisdLevelsBe) >= 1
    latestBeIndex = array.size(cisdLevelsBe) - 1
    latestBe      = array.get(cisdLevelsBe, latestBeIndex)

    // As long as body high is not above CISD, extend the line
    if not (bodyHigh(0) > latestBe.level.get_y2()) and not latestBe.completed
        line.set_x2(latestBe.level, bar_index + lookAheadBars)
        label.set_x(latestBe.txt, bar_index + lookAheadBars)

    // Break: body high closes above CISD
    if bodyHigh(0) > latestBe.level.get_y2() and not latestBe.completed
        latestBe.completed := true
        array.set(cisdLevelsBe, latestBeIndex, latestBe)

        // Spawn new bullish CISD from current bottom anchor
        bullishLine  = line.new(bearishBreakIndex, potentialBottomPrice, bar_index + lookAheadBars, potentialBottomPrice, color = bearishBreakColor, width = lineWidth, style = lineStyle)
        bullishLabel = label.new(bar_index + lookAheadBars, potentialBottomPrice, bearStr, color = color.new(color.white, 100), textcolor = bearishBreakColor, style = label.style_label_left, text_font_family = font.family_monospace, size = size.small, text_formatting = text.format_italic)
        bu = cisd.new(bullishLine, bullishLabel, false)
        array.push(cisdLevelsBu, bu)

        currentState := true
