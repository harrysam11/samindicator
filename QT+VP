f_get_sb_color_norm(_arr, _c_bull, _c_bear, _c_sand, _c_neut) =>
    bool _act_n_bear = array.size(_arr) > 13 ? array.get(_arr, 10) : false
    bool _act_n_bull = array.size(_arr) > 13 ? array.get(_arr, 11) : false
    bool _act_h_bear = array.size(_arr) > 13 ? array.get(_arr, 12) : false
    bool _act_h_bull = array.size(_arr) > 13 ? array.get(_arr, 13) : false

    bool _run_bull = _act_h_bull and (array.size(_arr) > 9 ? array.get(_arr, 5) : false)
    bool _run_bear = _act_h_bear and (array.size(_arr) > 9 ? array.get(_arr, 4) : false)
    bool _div_bull = _act_n_bull and (array.size(_arr) > 9 ? (array.get(_arr, 3) or array.get(_arr, 2) or array.get(_arr, 7)) : false)
    bool _div_bear = _act_n_bear and (array.size(_arr) > 9 ? (array.get(_arr, 1) or array.get(_arr, 0) or array.get(_arr, 6)) : false)

    color _c_out = _c_neut 

    bool _conflict_runs = _run_bull and _run_bear
    bool _conflict_bear_run_bull_div = _run_bear and _div_bull
    bool _conflict_bull_run_bear_div = _run_bull and _div_bear
    bool _conflict_divs = _div_bull and _div_bear

    if _conflict_runs or _conflict_bear_run_bull_div or _conflict_bull_run_bear_div or _conflict_divs
        _c_out := _c_sand  
    else if _run_bull      
        _c_out := _c_bull
    else if _run_bear      
        _c_out := _c_bear
    else if _div_bull      
        _c_out := _c_bull
    else if _div_bear      
