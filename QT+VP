to_is_current_period(int trigger_time, string type) =>
    bool current = false
    if trigger_time == 0 or na(trigger_time)
        current := false
    else
        string ny_tz = "America/New_York"
        int t_y = year(trigger_time, ny_tz)
        int t_m = month(trigger_time, ny_tz)
        int t_d = dayofmonth(trigger_time, ny_tz)
        int c_y = year(time, ny_tz)
        int c_m = month(time, ny_tz)
        int c_d = dayofmonth(time, ny_tz)
        
        if type == "D"
            current := (t_d == c_d and t_m == c_m and t_y == c_y)
        else if type == "W"
            int t_w = weekofyear(trigger_time, ny_tz)
            int c_w = weekofyear(time, ny_tz)
            bool is_sunday = dayofweek(time, ny_tz) == dayofweek.sunday
            current := (t_w == c_w and t_y == c_y and not is_sunday)
        else if type == "M"
            current := (t_m == c_m and t_y == c_y)
        else if type == "Q"
            int t_q = math.floor((t_m - 1) / 3)
            int c_q = math.floor((c_m - 1) / 3)
            current := (t_q == c_q and t_y == c_y)
        else if type == "Y"
            current := (t_y == c_y)
        else if type == "SESS" or type == "90M"
            current := (t_d == c_d and t_m == c_m and t_y == c_y)
    current

