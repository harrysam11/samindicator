add_to_line_array(arr, value) =>
    array.unshift(arr, value)
    if array.size(arr) > ssmt_history_limit
        line.delete(array.pop(arr))
add_to_label_array(arr, value) =>
    array.unshift(arr, value)
    if array.size(arr) > ssmt_history_limit
        label.delete(array.pop(arr))

f_leap_year(y) =>
    y % 4 == 0 and (y % 100 != 0 or y % 400 == 0)
f_month_length(is_leap, m) =>
    if m == 2
        is_leap ? 29 : 28
    else if (m == 4 or m == 6 or m == 9 or m == 11)
        30
    else
        31

msDay   = 24 * 60 * 60 * 1000
msWeek  = 7  * 24 * 60 * 60 * 1000
ms90m   = 90 * 60 * 1000
msMicro = 1350000  // 22.5 minutes in ms
yy  = year(time, tz)
mo  = month(time, tz)
dom = dayofmonth(time, tz)
dow = dayofweek(time, tz)

dayStartToday = timestamp(tz, yy, mo, dom, dayStartHour, 0)
dayStart      = time >= dayStartToday ? dayStartToday : (dayStartToday - msDay)
minsFromDayStart = int(((time - dayStart) % msDay) / (60 * 1000))  // 0..1439

yy_c  = year(dayStart, tz)
mo_c  = month(dayStart, tz)
dom_c = dayofmonth(dayStart, tz)
dow_c = dayofweek(dayStart, tz)

qYear = mo_c <= 3 ? 1 : mo_c <= 6 ? 2 : mo_c <= 9 ?
  3 : 4
is_year1 = qYear == 1
is_year2 = qYear == 2
is_year3 = qYear == 3
is_year4 = qYear == 4

// ✦✦✦ UPDATED QUARTERLY MATH ✦✦✦
q2Month = ((mo_c - 1) % 3) + 1
// ✦✦✦ ---------------------- ✦✦✦

is_quarter1 = q2Month == 1
is_quarter2 = q2Month == 2
is_quarter3 = q2Month == 3
