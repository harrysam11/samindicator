            line.delete(smtbeh)
            array.remove(arr_beh,0)
            if not hidelabels and array.size(arr_lbh) > 0
                label.delete(smtbe)
                array.remove(arr_lbh,0)
        if array.size(arr_beh) > 0 and showon
            for i = array.size(arr_beh) -1 to 0
                dline = array.get(arr_beh,i)
                top    = line.get_y2(dline)
                tme    = line.get_x2(dline)
                if time > tme and high >= top
                    line.delete(dline)
                    array.remove(arr_beh,i)
                    if not hidelabels and array.size(arr_lbh) > 0
                        dlbl   = array.get(arr_lbh,i)
                        label.delete(dlbl)
                        array.remove(arr_lbh,i)

    if array.size(arr_bul) > 0 and showon and _tfok 
        if _val_ses == _val_ses[1] and _bull0[1] and not _bull0
            line.delete(smtbul)
            array.remove(arr_bul,0)
            if not hidelabels and array.size(arr_lbl) > 0
                label.delete(smtbu)
                array.remove(arr_lbl,0)
        if array.size(arr_bul) > 0 and showon and _tfok 
            for i = array.size(arr_bul) -1 to 0
                dline = array.get(arr_bul,i)
                bot    = line.get_y2(dline)
                tme    = line.get_x2(dline)
                if time > tme and low <= bot
                    line.delete(dline)
                    array.remove(arr_bul,i)
                    if not hidelabels and array.size(arr_lbl) > 0
                        dlbl   = array.get(arr_lbl,i)
                        label.delete(dlbl)
                        array.remove(arr_lbl,i)

    _is_act_beh = false
    if array.size(arr_beh) > 0
        if _time_limit > 0
            for i = 0 to array.size(arr_beh) - 1
                if line.get_x2(array.get(arr_beh, i)) >= _time_limit
                    _is_act_beh := true
                    break
        else
            _is_act_beh := true

    _is_act_bul = false
    if array.size(arr_bul) > 0
        if _time_limit > 0
            for i = 0 to array.size(arr_bul) - 1
                if line.get_x2(array.get(arr_bul, i)) >= _time_limit
                    _is_act_bul := true
                    break
        else
            _is_act_bul := true

    float h_c  = ta.valuewhen(time == _hmaxt, close, 0)
    float h_o  = ta.valuewhen(time == _hmaxt, open, 0)
    float h_po = ta.valuewhen(time == _hmaxt, open[1], 0)
    float l_c  = ta.valuewhen(time == _lmint, close, 0)
    float l_o  = ta.valuewhen(time == _lmint, open, 0)
    float l_po = ta.valuewhen(time == _lmint, open[1], 0)

    int tfs = timeframe.in_seconds(timeframe.period)
    bool qcisd_vis = false
    string ssmt_src = ""
    
    if name == "Micro"
        qcisd_vis := tfs >= 60 and tfs <= 120
        ssmt_src := "Mic"
    else if name == "90m"
        qcisd_vis := tfs >= 180 and tfs <= 600
        ssmt_src := "90m"
    else if name == "Daily"
        qcisd_vis := tfs >= 900 and tfs <= 1800
        ssmt_src := "D"
    else if name == "Weekly"
        qcisd_vis := tfs >= 3600 and tfs <= 10800
        ssmt_src := "W"
    else if name == "Monthly"
        qcisd_vis := tfs >= 14400 and tfs <= 21600
        ssmt_src := "M"
    else if name == "Quarterly"
        qcisd_vis := tfs == 86400
        ssmt_src := "Q"
    else if name == "Yearly"
        qcisd_vis := tfs >= 604800 and tfs <= timeframe.in_seconds("1M")
        ssmt_src := "Y"

    bool new_bear_signal  = _bear0 and not _bear0[1]
    bool bear_pivot_moved = _bear0 and _hmaxt != _hmaxt[1]
    bool new_bull_signal  = _bull0 and not _bull0[1]
    bool bull_pivot_moved = _bull0 and _lmint != _lmint[1]
    
    int ext_len_qcisd = timeframe.in_seconds(timeframe.period) * 1000 * 10
    int bar_ms = timeframe.in_seconds(timeframe.period) * 1000
    string font_fam = qcisd_mono ? font.family_monospace : font.family_default
    string p_name = pair == 2 ? ssmt_pair : ssmt_pair2

    if showon and _tfok and show_qcisd and qcisd_vis
        
        if new_bear_signal or bear_pivot_moved
            float lvl = (h_c > h_o) ? h_o : h_po
            bool is_hp = bias_input == "Bearish"

            if not na(lvl)
                bool skip_creation = false
                
                if array.size(g_q_dirs) > 0
                    for i = array.size(g_q_dirs) - 1 to 0
                        if array.get(g_q_dirs, i) == -1 and array.get(g_q_names, i) == name
                            float ex_x1 = line.get_x1(array.get(g_q_lines, i))
                            if ex_x1 == _hmaxt or ex_x1 == (_hmaxt - bar_ms)
                                if array.get(g_q_hp, i) == is_hp
                                    skip_creation := true 
                                else
                                    line.delete(array.remove(g_q_lines, i))
                                    label.delete(array.remove(g_q_lbls, i))
                                    array.remove(g_q_dirs, i)
                                    array.remove(g_q_hp, i)
                                    array.remove(g_q_conf, i)
                                    array.remove(g_q_names, i)
                                    array.remove(g_q_pairs, i)
                            else if bear_pivot_moved
                                line.delete(array.remove(g_q_lines, i))
                                label.delete(array.remove(g_q_lbls, i))
                                array.remove(g_q_dirs, i)
                                array.remove(g_q_hp, i)
                                array.remove(g_q_conf, i)
                                array.remove(g_q_names, i)
                                array.remove(g_q_pairs, i)

                if not skip_creation
                    bool is_conf = close < lvl
                    string style_to_use = is_conf ? line.style_solid : line.style_dashed
                    string hp_txt = is_hp ? "HP " : ""
                    string bear_lbl_text = "(-) " + hp_txt + ssmt_src + "_QCISD"

                    line l = na
                    label lb = na
                    if h_c > h_o
                        l := line.new(x1=_hmaxt, y1=lvl, x2=time + ext_len_qcisd, y2=lvl, xloc=xloc.bar_time, color=qcisd_bear_clr, style=style_to_use, width=qcisd_width)
                        lb := label.new(x=time + ext_len_qcisd, y=lvl, text=bear_lbl_text, xloc=xloc.bar_time, style=label.style_label_left, color=color.new(color.white, 100), textcolor=qcisd_text_clr, size=qcisd_lbl_size, text_font_family=font_fam)
                    else
                        l := line.new(x1=_hmaxt - bar_ms, y1=lvl, x2=time + ext_len_qcisd, y2=lvl, xloc=xloc.bar_time, color=qcisd_bear_clr, style=style_to_use, width=qcisd_width)
                        lb := label.new(x=time + ext_len_qcisd, y=lvl, text=bear_lbl_text, xloc=xloc.bar_time, style=label.style_label_left, color=color.new(color.white, 100), textcolor=qcisd_text_clr, size=qcisd_lbl_size, text_font_family=font_fam)

                    array.unshift(g_q_lines, l)
                    array.unshift(g_q_lbls, lb)
                    array.unshift(g_q_dirs, -1)
                    array.unshift(g_q_hp, is_hp)
                    array.unshift(g_q_conf, is_conf)
                    array.unshift(g_q_names, name)
                    array.unshift(g_q_pairs, p_name)

        if new_bull_signal or bull_pivot_moved
            float lvl = (l_c < l_o) ? l_o : l_po
            bool is_hp = bias_input == "Bullish"

            if not na(lvl)
                bool skip_creation = false
                
                if array.size(g_q_dirs) > 0
                    for i = array.size(g_q_dirs) - 1 to 0
                        if array.get(g_q_dirs, i) == 1 and array.get(g_q_names, i) == name
                            float ex_x1 = line.get_x1(array.get(g_q_lines, i))
                            if ex_x1 == _lmint or ex_x1 == (_lmint - bar_ms)
                                if array.get(g_q_hp, i) == is_hp
                                    skip_creation := true 
                                else
                                    line.delete(array.remove(g_q_lines, i))
                                    label.delete(array.remove(g_q_lbls, i))
                                    array.remove(g_q_dirs, i)
                                    array.remove(g_q_hp, i)
                                    array.remove(g_q_conf, i)
                                    array.remove(g_q_names, i)
                                    array.remove(g_q_pairs, i)
                            else if bull_pivot_moved
                                line.delete(array.remove(g_q_lines, i))
                                label.delete(array.remove(g_q_lbls, i))
                                array.remove(g_q_dirs, i)
                                array.remove(g_q_hp, i)
                                array.remove(g_q_conf, i)
                                array.remove(g_q_names, i)
                                array.remove(g_q_pairs, i)

                if not skip_creation
                    bool is_conf = close > lvl
                    string style_to_use = is_conf ? line.style_solid : line.style_dashed
                    string hp_txt = is_hp ? "HP " : ""
                    string bull_lbl_text = "(+) " + hp_txt + ssmt_src + "_QCISD"

                    line l = na
                    label lb = na
                    if l_c < l_o
                        l := line.new(x1=_lmint, y1=lvl, x2=time + ext_len_qcisd, y2=lvl, xloc=xloc.bar_time, color=qcisd_bull_clr, style=style_to_use, width=qcisd_width)
                        lb := label.new(x=time + ext_len_qcisd, y=lvl, text=bull_lbl_text, xloc=xloc.bar_time, style=label.style_label_left, color=color.new(color.white, 100), textcolor=qcisd_text_clr, size=qcisd_lbl_size, text_font_family=font_fam)
                    else
                        l := line.new(x1=_lmint - bar_ms, y1=lvl, x2=time + ext_len_qcisd, y2=lvl, xloc=xloc.bar_time, color=qcisd_bull_clr, style=style_to_use, width=qcisd_width)
                        lb := label.new(x=time + ext_len_qcisd, y=lvl, text=bull_lbl_text, xloc=xloc.bar_time, style=label.style_label_left, color=color.new(color.white, 100), textcolor=qcisd_text_clr, size=qcisd_lbl_size, text_font_family=font_fam)

                    array.unshift(g_q_lines, l)
                    array.unshift(g_q_lbls, lb)
                    array.unshift(g_q_dirs, 1)
                    array.unshift(g_q_hp, is_hp)
                    array.unshift(g_q_conf, is_conf)
                    array.unshift(g_q_names, name)
                    array.unshift(g_q_pairs, p_name)

    [_bear1,_bear0,_bull1,_bull0, ret_smtbe, ret_smtbu, _is_act_beh, _is_act_bul]

