                if line.get_x2(array.get(harr_beh, i)) >= _time_limit
                    _is_act_hbeh := true
                    break
        else
            _is_act_hbeh := true

    _is_act_hbul = false
    if array.size(harr_bul) > 0
        if _time_limit > 0
            for i = 0 to array.size(harr_bul) - 1
                if line.get_x2(array.get(harr_bul, i)) >= _time_limit
                    _is_act_hbul := true
                    break
        else
            _is_act_hbul := true

    [_hbear0,_lbull0, ret_hsmtbe, ret_hsmtbu, _is_act_hbeh, _is_act_hbul]

