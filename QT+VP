        line l_new = line.new(x1=time, y1=low, x2=time, y2=high, xloc=xloc.bar_time, extend=extend.both, color=qt_c_div, style=qt_get_line_style(qt_s_div), width=qt_w_div)
        array.push(qt_a_div, l_new)
        if array.size(qt_a_div) > qt_lim_div
            line.delete(array.shift(qt_a_div))
            
    if qt_show_boxes_tf_ok
        // MAIN SESSION BOX
        if qt_show_sess
            int qt_hard_end_sess = qt_session_start_time + MS_SESS - qt_GAP
            if qt_session_changed
                qt_box_main := box.new(left=qt_session_start_time, top=high, right=time, bottom=low, xloc=xloc.bar_time, border_color=qt_get_sess_brd(qt_cur_brd_main), border_style=qt_current_line_style, border_width=1, bgcolor=qt_get_fill(qt_cur_fill_main))
                array.push(qt_arr_b_main, qt_box_main)
                if array.size(qt_arr_b_main) > qt_lim_b_sess
                    box.delete(array.shift(qt_arr_b_main))
                
                if qt_show_lbl_main
                    qt_lbl_main := label.new(x=int(qt_session_start_time + MS_SESS/2), y=high, text=qt_current_session_name, xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_down, color=color.new(color.white, 100), textcolor=qt_c_lbl_text, size=size.tiny, text_font_family=qt_font_fam)
                    array.push(qt_arr_l_main, qt_lbl_main)
                    if array.size(qt_arr_l_main) > qt_lim_b_sess
                        label.delete(array.shift(qt_arr_l_main))
            
            // Update Main Box
            if not na(qt_box_main)
                box.set_right(qt_box_main, math.min(time, qt_hard_end_sess))
                box.set_bgcolor(qt_box_main, qt_get_fill(qt_cur_fill_main))
                box.set_border_color(qt_box_main, qt_get_sess_brd(qt_cur_brd_main))
                box.set_border_style(qt_box_main, qt_current_line_style)
                if high > box.get_top(qt_box_main) 
                    box.set_top(qt_box_main, high)
                if low < box.get_bottom(qt_box_main) 
                    box.set_bottom(qt_box_main, low)
                if qt_show_lbl_main and not na(qt_lbl_main)
                    label.set_y(qt_lbl_main, box.get_top(qt_box_main))
                    
        // 90 MINUTE CYCLES
        if qt_show_90
            int qt_idx_90 = math.floor(qt_time_elapsed / MS_90)
            if qt_idx_90 != qt_prev_idx_90 and qt_idx_90 < 4
                qt_prev_idx_90 := qt_idx_90
                int qt_start_90 = qt_session_start_time + (qt_idx_90 * MS_90)
                qt_box_90 := box.new(left=qt_start_90, top=high, right=time, bottom=low, xloc=xloc.bar_time, border_color=qt_get_90_brd(qt_cur_brd_90), border_style=qt_current_line_style, border_width=1, bgcolor=qt_get_fill(qt_cur_fill_90))
                array.push(qt_arr_b_90, qt_box_90)
                if array.size(qt_arr_b_90) > qt_lim_b_90
                    box.delete(array.shift(qt_arr_b_90))
            
            if not na(qt_box_90) and qt_idx_90 < 4
                int qt_hard_end_90 = qt_session_start_time + ((qt_idx_90 + 1) * MS_90) - qt_GAP
                box.set_right(qt_box_90, math.min(time, qt_hard_end_90))
                box.set_bgcolor(qt_box_90, qt_get_fill(qt_cur_fill_90))
                box.set_border_color(qt_box_90, qt_get_90_brd(qt_cur_brd_90))
                box.set_border_style(qt_box_90, qt_current_line_style)
                if high > box.get_top(qt_box_90) 
                    box.set_top(qt_box_90, high)
                if low < box.get_bottom(qt_box_90) 
                    box.set_bottom(qt_box_90, low)

        // MICRO CYCLES (22.5m)
        if qt_show_22
            int qt_idx_22 = math.floor(qt_time_elapsed / MS_22)
            if qt_idx_22 != qt_prev_idx_22 and qt_idx_22 < 16
                qt_prev_idx_22 := qt_idx_22
                int qt_start_22 = qt_session_start_time + (qt_idx_22 * MS_22)
                qt_box_22 := box.new(left=qt_start_22, top=high, right=time, bottom=low, xloc=xloc.bar_time, border_color=qt_get_22_brd(qt_cur_brd_22), border_style=qt_current_line_style, border_width=1, bgcolor=qt_get_fill(qt_cur_fill_22))
                array.push(qt_arr_b_22, qt_box_22)
                if array.size(qt_arr_b_22) > qt_lim_b_22
                    box.delete(array.shift(qt_arr_b_22))
            
            if not na(qt_box_22) and qt_idx_22 < 16
                int qt_hard_end_22 = qt_session_start_time + ((qt_idx_22 + 1) * MS_22) - qt_GAP
                box.set_right(qt_box_22, math.min(time, qt_hard_end_22))
                box.set_bgcolor(qt_box_22, qt_get_fill(qt_cur_fill_22))
                box.set_border_color(qt_box_22, qt_get_22_brd(qt_cur_brd_22))
                box.set_border_style(qt_box_22, qt_current_line_style)
                if high > box.get_top(qt_box_22) 
                    box.set_top(qt_box_22, high)
                if low < box.get_bottom(qt_box_22) 
